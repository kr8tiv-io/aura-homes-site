# Mailchimp Marketing API. Leave these blank until the account exists.
# Signups are still saved in data/signups.jsonl, which is not on the website.
# When the account is ready, fill these in and run: node tools/push-signups.mjs
# The key looks like 0123456789abcdef0123456789abcdef-us21
# MAILCHIMP_SERVER is optional. It is the suffix of the key (us21) when omitted.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER=
