---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevealHeading from '../components/RevealHeading.astro';
---

<BaseLayout
  title="This path is quiet"
  description="Return to Aura. One beautiful room at a time."
  descriptor="Not found"
  noindex
>
  <main id="top">
    <section class="page-lead miss">
      <p class="story-kicker">404</p>
      <RevealHeading as="h1">This path is quiet.</RevealHeading>
      <p class="story-lede">The rooms, the story, and a quote are still here.</p>
      <ul class="miss-links">
        <li><a href="/rooms">Rooms</a></li>
        <li><a href="/story">Story</a></li>
        <li><a href="/build-your-own">Build Your Own</a></li>
        <li><a href="/pre-order">Pre-order</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .miss-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.75rem;
    margin: 2.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .miss-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-cinzel);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #9c7a55;
  }
</style>
