---
import RevealHeading from '../components/RevealHeading.astro';
import { organizationJson } from '../lib/organization';

const organization = organizationJson(Astro.site ?? Astro.url.origin);
---
<title>Build Your Own | Aura Homes</title>
<meta name="robots" content="noindex" />
<link rel="canonical" href="/build-your-own" />
<meta http-equiv="refresh" content="0;url=/build-your-own" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
<RevealHeading as="h1"><a href="/build-your-own">Build Your Own</a></RevealHeading>
<script is:inline>
  location.replace('/build-your-own');
</script>
