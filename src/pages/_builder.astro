---
const origin = Astro.site ?? new URL('https://aurahomes.fun');
const canonical = new URL('build-your-own/', origin).href;
const target = '/build-your-own/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Build Your Own | Aura Homes</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <p><a href={target}>Build Your Own</a></p>
    <script is:inline>
      location.replace('/build-your-own/');
    </script>
  </body>
</html>
