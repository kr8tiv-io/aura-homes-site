---
import BaseLayout from '../layouts/BaseLayout.astro';
import Join from '../components/Join.astro';
import Journeys from '../components/Journeys.astro';
import { posterSrc } from '../lib/stills';

const wallPoster = await posterSrc('/film/farm-wall.webp');
const roomPoster = await posterSrc('/film/farm-room.webp');
---

<BaseLayout
  title="A wall that grows | Aura Homes"
  description="Beautiful second-life rooms that bring people back to nature, one room at a time."
  descriptor="Aura Farms"
>
  <main id="top">
    <canvas class="page-field" data-wash="room" aria-hidden="true"></canvas>
    <canvas class="field-light" data-field="room" aria-hidden="true"></canvas>

    <section class="page-lead">
      <p class="story-kicker">Aura Farms</p>
      <h1 data-glow>
        <span class="line-mask"><span class="line">A wall</span></span>
        <span class="line-mask"><span class="line">that grows.</span></span>
      </h1>
      <p class="story-lede">
        The same room, on its steel frame. One long side becomes a vertical aeroponic wall: channels of greens, herbs, and fruit, fed by a closed loop of water and nutrients. Aura Homes can build it and place it. You can buy it and grow for yourself.
      </p>
    </section>

    <section class="story-still">
      <figure class="story-figure">
        <video poster={wallPoster} data-film="/film/scroll/farm-wall.mp4" muted playsinline preload="none" disablepictureinpicture width="1248" height="832" data-shot="drift" data-play="drift" aria-label="Black glass room in a dusk meadow, one wall a vertical aeroponic garden"></video>
      </figure>
      <div>
        <p class="story-kicker">The wall</p>
        <h3><span class="line-mask"><span class="line">Grown on the side.</span></span></h3>
        <p>The glass stays smooth. The farm is the other long side: plants in vertical channels, lit so they keep growing after the meadow goes dark.</p>
      </div>
    </section>

    <section class="story-still is-flip">
      <figure class="story-figure">
        <video poster={roomPoster} data-film="/film/scroll/farm-room.mp4" muted playsinline preload="none" disablepictureinpicture width="1248" height="832" data-shot="tilt" data-play="push" aria-label="Honey oak room with a floor-to-ceiling aeroponic wall and meadow beyond the glass"></video>
      </figure>
      <div>
        <p class="story-kicker">Inside</p>
        <h3><span class="line-mask"><span class="line">Food, in the room.</span></span></h3>
        <p>Honey oak, a line of warm light, and the meadow still at the glass. The harvest is in the wall, not in a separate shed.</p>
      </div>
    </section>

    <section class="ways">
      <p class="story-kicker">What the farm adds</p>
      <ol>
        <li><span>01</span> Vertical aeroponic channels</li>
        <li><span>02</span> A closed water and nutrient loop</li>
        <li><span>03</span> Light for the plants</li>
        <li><span>04</span> The meadow still in view</li>
      </ol>
      <p class="story-lede">You can run it as your own farm. Aura Homes can also build the room and place it where the food is wanted.</p>
    </section>

    <section class="story-open">
      <p class="story-kicker">Yours, or the network</p>
      <h2 data-glow>
        <span class="line-mask"><span class="line">Buy the room.</span></span>
        <span class="line-mask"><span class="line">Or give the food.</span></span>
      </h2>
      <p class="story-lede">
        Two uses, one room. Buy it, grow, and keep the harvest. Or, as the network we hope to build, the food is given away and an advertiser’s name sits on it. The free-food network is the aim, not a contract you can sign today. The room is what you can ask for now.
      </p>
      <p class="story-lede"><a href="/journal/aura-farms">Read the farm note</a>, and <a href="/journal/free-food-and-water">the network</a>.</p>
    </section>

    <Journeys />

    <section id="enquire" class="enquire">
      <p class="story-kicker">Enquire</p>
      <h2 data-glow><span class="line-mask"><span class="line">Ask for the farm wall.</span></span></h2>
      <p class="story-lede enquire-note">Tell us if you want to grow for yourself, or if you want Aura Homes to build the room and place it.</p>
      <Join shell="farm" />
    </section>
  </main>
  <script>
    import { bindJourneyMotion } from '../scripts/journey';
    import { onPageLoad } from '../scripts/motion';
    onPageLoad(() => bindJourneyMotion());
  </script>
</BaseLayout>
