---
import BaseLayout from '../layouts/BaseLayout.astro';
import Join from '../components/Join.astro';
import Journeys from '../components/Journeys.astro';
import RevealHeading from '../components/RevealHeading.astro';
---

<BaseLayout
  title="A wall that grows | Aura Homes"
  description="Return to Aura. One beautiful room at a time."
  descriptor="Aura Farms"
>
  <main id="top">
    <canvas class="page-field" data-wash="room" aria-hidden="true"></canvas>
    <canvas class="field-light" data-field="room" aria-hidden="true"></canvas>

    <section class="page-lead">
      <p class="story-kicker">Aura Farms</p>
      <RevealHeading as="h1" glow>
        A wall <br />that grows.
      </RevealHeading>
      <p class="story-lede">
        Same Aura room, same clean lines, but one long wall is a vertical aeroponic garden: greens, herbs and fruit, fed by a closed loop of water and nutrients. Grow in it yourself, or have Aura build it and set it up.
      </p>
    </section>

    <section class="story-still">
      <figure class="story-figure">
        <video data-poster="/media/video/farm-wall-poster.webp" data-film="/media/video/farm-wall.mp4" data-film-webm="/media/video/farm-wall.webm" data-still="poster" muted loop playsinline preload="none" disablepictureinpicture width="1920" height="1280" data-shot="drift" data-play="drift" aria-label="Black glass room in a dusk meadow, one wall a vertical aeroponic garden"></video>
      </figure>
      <div>
        <p class="story-kicker">The wall</p>
        <h3><span class="line-mask"><span class="line">A garden on the wall.</span></span></h3>
        <p>One long side stays glass. The other is plants in vertical channels, with grow lights so they keep going after sunset.</p>
      </div>
    </section>

    <section class="story-still is-flip">
      <figure class="story-figure">
        <video data-poster="/media/video/farm-room-poster.webp" data-film="/media/video/farm-room.mp4" data-film-webm="/media/video/farm-room.webm" data-still="poster" muted loop playsinline preload="none" disablepictureinpicture width="1920" height="1280" data-shot="tilt" data-play="push" aria-label="Honey oak room with a floor-to-ceiling aeroponic wall and meadow beyond the glass"></video>
      </figure>
      <div>
        <p class="story-kicker">Inside</p>
        <h3><span class="line-mask"><span class="line">Dinner, ten steps away.</span></span></h3>
        <p>Honey oak, warm light and the meadow outside the glass. The garden is built into the wall, so the harvest is right there in the room.</p>
      </div>
    </section>

    <section class="ways">
      <p class="story-kicker">What the farm adds</p>
      <ol>
        <li><span>01</span> Vertical aeroponic channels</li>
        <li><span>02</span> A closed water and nutrient loop</li>
        <li><span>03</span> Light for the plants</li>
        <li><span>04</span> The meadow still in view</li>
      </ol>
      <p class="story-lede">Run it as your own little farm, or have Aura build it and set it up where the food is needed.</p>
    </section>

    <section class="story-open">
      <p class="story-kicker">Yours, or placed</p>
      <RevealHeading as="h2" glow>
        Grow your own. <br />Or let us set it up.
      </RevealHeading>
      <p class="story-lede">
        Two ways to use it. Grow in it yourself and keep the whole harvest. Or have Aura build the room and set it up for you. Either way, it starts with the waitlist.
      </p>
      <p class="story-lede"><a href="/journal/aura-farms">Read the farm note</a>, and <a href="/journal/free-food-and-water">the network</a>.</p>
    </section>

    <Journeys reveal />

    <section id="enquire" class="enquire">
      <p class="story-kicker">Enquire</p>
      <RevealHeading as="h2" glow>Want a garden wall?</RevealHeading>
      <p class="story-lede enquire-note">Tell us if you want to grow for yourself or have Aura set it up, and you are on the waitlist.</p>
      <Join shell="farm" />
    </section>
  </main>
  <script>
    import { bindJourneyMotion } from '../scripts/journey';
    import { onPageLoad } from '../scripts/motion';
    onPageLoad(() => bindJourneyMotion());
  </script>
</BaseLayout>
