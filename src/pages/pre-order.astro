---
import Join from '../components/Join.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pre-order | Aura Homes"
  description="Beautiful second-life rooms that bring people back to nature, one room at a time."
  descriptor="Pre-order"
>
  <main id="top">
    <section class="page-lead">
      <p class="story-kicker">Pre-order</p>
      <h1>Hold your place.</h1>
      <p class="story-lede">
        Tell us which room you want. You are among the first we write when that build opens. This page takes no payment. It holds your name.
      </p>
    </section>
    <section class="enquire" id="enquire">
      <Join shell="unsure" />
    </section>
  </main>
</BaseLayout>
