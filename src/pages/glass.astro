---
import BaseLayout from '../layouts/BaseLayout.astro';
import Join from '../components/Join.astro';
import Journeys from '../components/Journeys.astro';
import RevealHeading from '../components/RevealHeading.astro';
import AngleSet from '../components/AngleSet.astro';
---

<BaseLayout title="The glass | Aura Homes" description="Return to Aura. One beautiful room at a time.">
  <main id="top">
    <canvas class="page-field" data-wash="glass" aria-hidden="true"></canvas>
    <canvas class="field-light" data-field="glass" aria-hidden="true"></canvas>

    <section class="page-lead">
      <p class="story-kicker">Later</p>
      <RevealHeading as="h1" glow>
        The glass<br />comes next.
      </RevealHeading>
      <p class="story-lede">
        The room on the steel frame is the start. Helical piles, a floor lit from beneath, and a structured deck are how that room becomes a small place to stay.
      </p>
    </section>

    <section class="story-still">
      <figure class="story-figure">
        <video poster="/media/video/deck-poster.webp" data-film="/media/video/deck.mp4" data-film-webm="/media/video/deck.webm" data-still="poster" muted loop playsinline preload="none" disablepictureinpicture width="1920" height="1290" data-shot="tilt" data-play="push" aria-label="A-frame in snow with a wide deck, cargo net, and glass floor lit from beneath"></video>
      </figure>
      <div>
        <p class="story-kicker">The floor</p>
        <h3 data-glow><span class="line-mask"><span class="line">Lit from beneath.</span></span></h3>
        <p>
          Clear or tinted, the glass floor carries light under the deck. The picture shows that floor, the net, and the span. Glass railings are part of the custom work.
        </p>
      </div>
    </section>

    <section class="story-still is-flip">
      <figure class="story-figure">
        <video poster="/media/video/tower-poster.webp" data-film="/media/video/tower.mp4" data-film-webm="/media/video/tower.webm" data-still="poster" muted loop playsinline preload="none" disablepictureinpicture width="1920" height="2160" data-shot="lift" data-play="rise" aria-label="Round glass tower in snow, with mesh balconies and a lit floor"></video>
      </figure>
      <div>
        <p class="story-kicker">The balcony</p>
        <h3 data-glow><span class="line-mask"><span class="line">Held in the air.</span></span></h3>
        <p>
          The picture is the tower, the mesh, and the balconies. Glass railings, and helical piles under a deck this size, are the custom work. Nothing sits on blocks.
        </p>
      </div>
    </section>

    <AngleSet
      kicker="Closer"
      title="The same glass, other hours."
      angles={[
        {
          src: '/media/specialty/aframe-deck-detail-dusk.jpg',
          alt: 'Close view of an A-frame glass deck at dusk, a steaming round wood tub, a floor lit from beneath, a cargo net in front, and snowy mountains beyond.',
          caption: 'The floor, lit, with the tub and the net.',
        },
        {
          src: '/media/specialty/aframe-aerial-blue-hour-snow.jpg',
          alt: 'Aerial view of an A-frame in snow among pines at blue hour, lit stairs rising to a glass deck, a river and snow peaks beyond.',
          caption: 'Blue hour over the valley, the deck still warm.',
        },
        {
          src: '/media/specialty/tower-glass-detail-blue-hour.jpg',
          alt: 'Close curved glass of a round tower at blue hour, wood sofas inside, a snowy mesh hammock, and a telescope on the roof rail, with snow mountains behind.',
          caption: 'Curved glass, a hammock, and the first snow.',
        },
        {
          src: '/media/specialty/tower-winter-dusk-wide.jpg',
          alt: 'A round glass tower in a snow field at deep blue dusk, spiral stair, sauna, tub, pines, snow peaks, and a line of string lights.',
          caption: 'The tower at dusk, stairs down to the snow.',
        },
      ]}
    />

    <section class="passage" data-passage aria-label="Helical piles">
      <canvas data-meadow data-scene="slope"></canvas>
      <p class="passage-ghost" aria-hidden="true">Pile</p>
      <div class="passage-copy">
        <p class="story-kicker">The ground</p>
        <RevealHeading as="h2" glow>Screwed into the slope.</RevealHeading>
        <p>About thirty minutes from Banff and from Kicking Horse. Off the grid, and still close to the hill.</p>
      </div>
    </section>
    <div class="passage-spacer" data-passage-spacer aria-hidden="true"></div>

    <section class="ways">
      <p class="story-kicker">What the glass adds</p>
      <ol>
        <li><span>01</span> Helical piles</li>
        <li><span>02</span> A glass floor, clear or tinted</li>
        <li><span>03</span> A structured deck, and a net</li>
        <li><span>04</span> Balconies with glass railings</li>
      </ol>
      <p class="story-lede">SIP panels, solar, and atmospheric water sit behind the room. They keep it off the grid. They are not the view. <a href="/water">Thirst Contact</a> is a later fit of the same room, and it still needs further research.</p>
    </section>

    <Journeys reveal />

    <section id="enquire" class="enquire">
      <p class="story-kicker">Enquire</p>
      <RevealHeading as="h2" glow>Begin with the room.</RevealHeading>
      <p class="story-lede enquire-note">The glass is the next build. The room is the one we can place now.</p>
      <Join shell="glass" />
    </section>
  </main>

  <script>
    import { bindJourneyMotion } from '../scripts/journey';
    import { onPageLoad } from '../scripts/motion';
    onPageLoad(() => bindJourneyMotion());
  </script>
</BaseLayout>
