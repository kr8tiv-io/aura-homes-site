---
import BaseLayout from '../layouts/BaseLayout.astro';
import Join from '../components/Join.astro';
import Journeys from '../components/Journeys.astro';
import RevealHeading from '../components/RevealHeading.astro';
import AngleSet from '../components/AngleSet.astro';
---

<BaseLayout title="The decks | Aura Homes" description="Return to Aura. One beautiful room at a time.">
  <main id="top">
    <canvas class="page-field" data-wash="glass" aria-hidden="true"></canvas>
    <canvas class="field-light" data-field="glass" aria-hidden="true"></canvas>

    <section class="page-lead">
      <p class="story-kicker">Later</p>
      <RevealHeading as="h1" glow>
        Polycarbonate decks, <br />coming next.
      </RevealHeading>
      <p class="story-lede">
        Rooms come first. Next, we lift them onto helical piles with a polycarbonate floor lit from underneath and a big deck, so a room on a hillside becomes a place to stay.
      </p>
    </section>

    <section class="story-still">
      <figure class="story-figure">
        <video data-poster="/media/video/deck-poster.webp" data-film="/media/video/deck.mp4" data-film-webm="/media/video/deck.webm" data-still="poster" muted loop playsinline preload="none" disablepictureinpicture width="1920" height="1290" data-shot="tilt" data-play="push" aria-label="Gabled polycarbonate room in snow with a wide deck, cargo net, and a polycarbonate floor lit from beneath"></video>
      </figure>
      <div>
        <p class="story-kicker">The floor</p>
        <h3 data-glow><span class="line-mask"><span class="line">A floor that glows.</span></span></h3>
        <p>
          A clear or tinted polycarbonate floor with lights underneath, so the deck glows at night. Add a net to lie in. Polycarbonate railings are part of the custom build.
        </p>
      </div>
    </section>

    <section class="story-still is-flip">
      <figure class="story-figure">
        <video data-poster="/media/video/tower-poster.webp" data-film="/media/video/tower.mp4" data-film-webm="/media/video/tower.webm" data-still="poster" muted loop playsinline preload="none" disablepictureinpicture width="1920" height="2160" data-shot="lift" data-play="rise" aria-label="Round polycarbonate tower in snow, with mesh balconies and a lit floor"></video>
      </figure>
      <div>
        <p class="story-kicker">The balcony</p>
        <h3 data-glow><span class="line-mask"><span class="line">Balconies with a view down.</span></span></h3>
        <p>
          Mesh balconies, polycarbonate railings and a deck this big all sit on helical piles screwed into the ground. Nothing sits on blocks.
        </p>
      </div>
    </section>

    <AngleSet
      kicker="Closer"
      title="Same deck, different moods."
      angles={[
        {
          src: '/media/specialty/aframe-deck-detail-dusk.jpg',
          alt: 'Close view of the polycarbonate deck on a gabled room at dusk, a steaming round wood tub, a floor lit from beneath, a cargo net in front, and snowy mountains beyond.',
          caption: 'The glowing floor, the hot tub and the net.',
        },
        {
          src: '/media/specialty/aframe-aerial-blue-hour-snow.jpg',
          alt: 'Aerial view of a gabled polycarbonate room in snow among pines at blue hour, lit stairs rising to a polycarbonate deck, a river and snow peaks beyond.',
          caption: 'Blue hour over the valley.',
        },
        {
          src: '/media/specialty/tower-glass-detail-blue-hour.jpg',
          alt: 'Close curved polycarbonate of a round tower at blue hour, wood sofas inside, a snowy mesh hammock, and a telescope on the roof rail, with snow mountains behind.',
          caption: 'Curved polycarbonate, a hammock and the first snow.',
        },
        {
          src: '/media/specialty/tower-winter-dusk-wide.jpg',
          alt: 'A round polycarbonate tower in a snow field at deep blue dusk, spiral stair, sauna, tub, pines, snow peaks, and a line of string lights.',
          caption: 'The tower at dusk, stairs down to the snow.',
        },
      ]}
    />

    <section class="passage" data-passage aria-label="Helical piles">
      <canvas data-meadow data-scene="slope" data-poster="/media/video/deck-poster.webp"></canvas>
      <p class="passage-ghost" aria-hidden="true">Pile</p>
      <div class="passage-copy">
        <p class="story-kicker">The ground</p>
        <RevealHeading as="h2" glow>Built right into the hillside.</RevealHeading>
        <p>Picture it about thirty minutes from Banff or Kicking Horse. Off the grid, and still close to the ski hill.</p>
      </div>
    </section>
    <div class="passage-spacer" data-passage-spacer aria-hidden="true"></div>

    <section class="ways">
      <p class="story-kicker">What the decks add</p>
      <ol>
        <li><span>01</span> Helical piles</li>
        <li><span>02</span> A polycarbonate floor, clear or tinted</li>
        <li><span>03</span> A structured deck, and a net</li>
        <li><span>04</span> Balconies with polycarbonate railings</li>
      </ol>
      <p class="story-lede">SIP panels, solar and atmospheric water keep it off the grid, tucked out of sight so they never block the view. <a href="/water">Thirst Contact</a> is the same room, with a standard atmospheric water generator, pulling water from the sky and bottling it in the backyard.</p>
    </section>

    <Journeys reveal />

    <section id="enquire" class="enquire">
      <p class="story-kicker">Enquire</p>
      <RevealHeading as="h2" glow>Start with a room.</RevealHeading>
      <p class="story-lede enquire-note">The polycarbonate decks come next. The rooms come first, and the waitlist is open.</p>
      <Join shell="glass" />
    </section>
  </main>

  <script>
    import { bindJourneyMotion } from '../scripts/journey';
    import { onPageLoad } from '../scripts/motion';
    onPageLoad(() => bindJourneyMotion());
  </script>
</BaseLayout>
