---
import DepthImage from '../components/DepthImage.astro';
import HeroMist from '../components/HeroMist.astro';
import LivingHero from '../components/LivingHero.astro';
import RevealHeading from '../components/RevealHeading.astro';
import WindowFrame from '../components/WindowFrame.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { httpsUrl, youtubeUrl } from '../data/site';

const youtube = httpsUrl(youtubeUrl);
---

<BaseLayout
  title="Story | Aura Homes"
  description="Aura builds beautiful rooms that get people back outside."
  descriptor="Story"
>
  <main id="top" class="story-essay">
    <LivingHero
      id="why"
      labelledby="why-title"
      film="/media/video/hero-meadow.mp4"
      poster="/film/story-meadow-side.webp"
      alt="A low glass room in tall grass, with a cedar tub and a hanging daybed, pines and a pale mountain behind."
      width={2560}
      height={1844}
      eager
    >
      <div data-rise>
        <p class="story-kicker">Why we exist</p>
        <RevealHeading as="h1" id="why-title">Back to where we came from.</RevealHeading>
        <p class="story-lede">
          Aura builds beautiful rooms that get people back outside.
        </p>
      </div>
    </LivingHero>

    <section class="story-chapter story-follow">
      <div class="story-prose" data-rise>
        <p>
          Glass, steel and warm wood, placed on your land so nature does most of the talking. Each one is a real extension of your home: a bedroom under the stars, an office in the trees, a hot tub with a view.
        </p>
      </div>
    </section>

    <figure class="story-bleed" data-window>
      <WindowFrame>
        <DepthImage
          src="/film/story-meadow-side.webp"
          alt="A low glass room in tall grass, with pines and a pale mountain behind it."
          phonePosition="34% center"
        />
      </WindowFrame>
      <HeroMist />
    </figure>

    <section class="story-chapter" id="started" aria-labelledby="started-title">
      <div data-rise>
        <p class="story-kicker" data-tracer="rule">Why it started</p>
        <RevealHeading as="h2" id="started-title">Where the idea came from.</RevealHeading>
      </div>
      <div class="story-prose" data-rise>
        <p>
          Matt spent years travelling through Central America, watching people build beautiful things that work with nature instead of against it. Shade, water, walls and roofs, all made for the place they stand in. He brought that home to Alberta.
        </p>
      </div>
    </section>

    <figure class="story-bleed" data-window>
      <WindowFrame>
        <DepthImage
          src="/film/layout-forest.webp"
          alt="A glass room at the edge of a pine forest, open toward a dusk meadow."
          phonePosition="42% center"
        />
      </WindowFrame>
    </figure>

    <section class="story-chapter" id="chapter" aria-labelledby="chapter-title">
      <div data-rise>
        <p class="story-kicker" data-tracer="rule">Chapter one</p>
        <RevealHeading as="h2" id="chapter-title">Where we are now.</RevealHeading>
      </div>
      <div class="story-prose" data-rise>
        <p>
          Aura is a small shop in Alberta at the concept stage. Ordering isn&rsquo;t open yet, but the <a href="/pre-order">waitlist</a> is. We&rsquo;re building in public, and a YouTube channel will show every step, the clean ones and the messy ones.
        </p>
        {youtube && <p class="story-yt"><a href={youtube}>Follow the build on YouTube</a></p>}
      </div>
      <blockquote class="story-quote" data-rise>
        <p>Nobody believes in you until it's too late, so we're just going to build it.</p>
      </blockquote>
    </section>

    <figure class="story-bleed" data-window>
      <WindowFrame>
        <DepthImage
          src="/film/story-room.webp"
          alt="An open room of oak and linen, facing a green field at dusk."
          phonePosition="36% center"
        />
      </WindowFrame>
    </figure>

    <section class="story-chapter" id="gift" aria-labelledby="gift-title">
      <div data-rise>
        <p class="story-kicker">What comes next</p>
        <RevealHeading as="h2" id="gift-title">Where it&rsquo;s going.</RevealHeading>
      </div>
      <div class="story-prose" data-rise>
        <p>
          Rooms come first. Revenue from the rooms funds what comes next: grow rooms that produce food, Thirst Contact units that pull drinking water from the air, eco resorts and full eco homes. Every step means less reliance on the grid and more time outside.
        </p>
      </div>
    </section>

    <figure class="story-bleed" data-window>
      <WindowFrame>
        <DepthImage
          src="/film/layout-sky.webp"
          alt="A bed under a skylight, with the meadow and a dark treeline beyond the glass."
          phonePosition="center 42%"
        />
      </WindowFrame>
    </figure>

    <section class="story-chapter" id="matters" aria-labelledby="matters-title">
      <div data-rise>
        <p class="story-kicker">Nature as a gift</p>
        <RevealHeading as="h2" id="matters-title">Why it matters.</RevealHeading>
      </div>
      <div class="story-prose" data-rise>
        <p>Morning coffee outside. Kids off their screens. More of your day spent in the beauty that&rsquo;s already around you. That&rsquo;s the whole point.</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .story-essay {
    color: #14120e;
  }
  .story-essay .story-chapter {
    position: relative;
    z-index: 1;
    padding: 14vh 8vw 16vh;
  }
  .story-essay .story-follow {
    padding-top: 10vh;
  }
  .story-follow .story-prose {
    margin-top: 0;
  }
  :global(.story-essay .story-chapter h2),
  :global(.story-founder h2) {
    margin: 0;
    max-width: 12em;
    font-family: var(--font-cinzel);
    font-weight: 400;
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    line-height: 1.08;
    letter-spacing: 0.035em;
  }
  .story-prose {
    max-width: 36rem;
    margin-top: 2.75rem;
  }
  .story-prose p {
    margin: 0 0 1.35rem;
    font-weight: 300;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(20, 18, 14, 0.78);
  }
  .story-prose p:last-child {
    margin-bottom: 0;
  }
  .story-essay a {
    color: inherit;
  }
  .story-quote {
    margin: 3rem 0 0;
    max-width: 16em;
    padding: 0;
    border: 0;
  }
  .story-quote p {
    margin: 0;
    font-family: var(--font-cinzel);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.2vw, 2.55rem);
    line-height: 1.22;
    letter-spacing: 0.035em;
  }
  .story-bleed {
    margin: 0;
    height: min(86vh, 920px);
    overflow: hidden;
    background: #0c0d0e;
  }
  .story-bleed img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .story-founder {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) minmax(0, 34rem);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: end;
    padding: 14vh 8vw 18vh;
  }
  .story-portrait {
    position: relative;
    margin: 0;
  }
  .story-portrait-frame {
    aspect-ratio: 3 / 4;
    background: #14120e;
    box-shadow: inset 0 0 0 1px rgba(196, 160, 122, 0.35);
  }
  .story-portrait figcaption {
    position: absolute;
    left: 1.15rem;
    bottom: 1.15rem;
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #c4a07a;
  }
  .story-yt {
    margin: 2.4rem 0 0;
    font-family: var(--font-cinzel);
    font-weight: 400;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }
  .story-yt a {
    color: inherit;
    text-decoration: none;
  }
  .story-yt a:hover,
  .story-yt a:focus-visible {
    color: #866243;
  }

  @media (max-width: 800px) {
    .story-essay .story-chapter {
      padding: 10vh 1.5rem 12vh;
    }
    .story-essay .story-follow {
      padding-top: 8vh;
    }
    .story-bleed {
      /* The photograph's own ratio, so the room stays in the frame
         instead of a tall cover that scrolls down to grass. */
      height: auto;
      aspect-ratio: 1280 / 922;
    }
    .story-founder {
      grid-template-columns: 1fr;
      justify-items: start;
      padding: 10vh 1.5rem 14vh;
    }
    .story-portrait {
      width: min(16rem, 72vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-bleed picture,
    .story-bleed img {
      height: 100%;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion, onPageLoad } from '../scripts/motion';

  onPageLoad(() => {

  const page = document.querySelector('.story-essay');
  if (page && !prefersReducedMotion()) {
    ScrollTrigger.getAll()
      .filter((trigger) => trigger.vars.id === 'story-rise')
      .forEach((trigger) => trigger.kill());

    gsap.utils.toArray<HTMLElement>('[data-rise]', page).forEach((el) => {
      const bleed = Boolean(el.closest('.story-bleed'));
      gsap.from(el, {
        y: bleed ? 32 : 22,
        opacity: 0,
        duration: bleed ? 2.1 : 1.8,
        ease: 'power3.out',
        scrollTrigger: {
          id: 'story-rise',
          trigger: el,
          start: 'top 90%',
          once: true,
        },
      });
    });

    const settle = () => ScrollTrigger.refresh();
    requestAnimationFrame(settle);
    window.addEventListener('load', settle, { once: true });
  }
  });
</script>
