---
import DepthImage from '../components/DepthImage.astro';
import LivingHero from '../components/LivingHero.astro';
import RevealHeading from '../components/RevealHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Back to nature | Aura Homes"
  description="Beautiful second-life rooms that bring people back to nature, one room at a time."
  descriptor="Back to nature"
>
  <main id="top" class="wild">
    <LivingHero
      labelledby="wild-morning"
      film="/film/hero/room.mp4"
      poster="/film/story-room.webp"
      alt="An open wood room facing a meadow at blue hour, with a low seat and a deck in front."
      width={1280}
      height={914}
      eager
    >
      <DepthImage
        slot="still"
        src="/film/story-room.webp"
        alt="An open wood room facing a meadow at blue hour, with a low seat and a deck in front."
        loading="eager"
        fetchpriority="high"
        field
      />
      <RevealHeading as="h1" id="wild-morning">Morning coffee, outside.</RevealHeading>
    </LivingHero>

    <LivingHero
      labelledby="wild-kids"
      film="/film/hero/lounge.mp4"
      poster="/film/layout-lounge-wind.webp"
      alt="A linen sofa in a wood room, facing tall grass and a blue evening."
      width={1280}
      height={922}
    >
      <DepthImage
        slot="still"
        src="/film/layout-lounge-wind.webp"
        alt="A linen sofa in a wood room, facing tall grass and a blue evening."
        field
      />
      <RevealHeading as="h2" id="wild-kids">Kids off the screens.</RevealHeading>
    </LivingHero>

    <LivingHero
      labelledby="wild-steam"
      film="/film/hero/meadow.mp4"
      poster="/film/story-meadow-side.webp"
      alt="A wood-fired tub letting off steam beside an open room, with tall grass in front."
      width={1280}
      height={922}
    >
      <DepthImage
        slot="still"
        src="/film/story-meadow-side.webp"
        alt="A wood-fired tub letting off steam beside an open room, with tall grass in front."
        field
      />
      <RevealHeading as="h2" id="wild-steam">The steam keeps its own time.</RevealHeading>
    </LivingHero>

    <LivingHero
      labelledby="wild-moon"
      film="/film/hero/deck.mp4"
      poster="/film/resort-deck.webp"
      alt="A lit deck at blue hour, with a wood-fired tub and mountains behind it."
      width={1280}
      height={860}
    >
      <DepthImage
        slot="still"
        src="/film/resort-deck.webp"
        alt="A lit deck at blue hour, with a wood-fired tub and mountains behind it."
        field
      />
      <RevealHeading as="h2" id="wild-moon">The moon coming up over the deck.</RevealHeading>
    </LivingHero>

    <section class="wild-end" aria-labelledby="wild-end-title">
      <RevealHeading as="h2" id="wild-end-title">The room is how you stay out here.</RevealHeading>
      <p class="wild-links" data-rise>
        <a href="/rooms">Rooms</a>
        <a href="/pre-order">Pre-order</a>
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .wild-end {
    padding: 22vh 8vw 20vh;
    color: #14120e;
  }
  :global(.wild-end h2) {
    margin: 0;
    max-width: 11em;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .wild-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.4rem;
    margin: 2.75rem 0 0;
  }
  .wild-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    letter-spacing: -0.02em;
    color: #14120e;
    text-decoration: none;
    border-bottom: 1px solid #9c7a55;
    padding-bottom: 0.2rem;
    transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .wild-links a:hover {
    opacity: 0.55;
  }

  @media (max-width: 800px) {
    .wild-end {
      padding: 16vh 1.5rem 14vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wild-links a {
      transition: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion, onPageLoad } from '../scripts/motion';

  onPageLoad(() => {

  const page = document.querySelector('.wild');
  if (page && !prefersReducedMotion()) {
    ScrollTrigger.getAll()
      .filter((trigger) => trigger.vars.id === 'wild-rise')
      .forEach((trigger) => trigger.kill());

    gsap.utils.toArray<HTMLElement>('[data-rise]', page).forEach((el) => {
      gsap.from(el, {
        y: 20,
        opacity: 0,
        duration: 1.9,
        ease: 'power3.out',
        scrollTrigger: {
          id: 'wild-rise',
          trigger: el,
          start: 'top 88%',
          once: true,
        },
      });
    });

    const settle = () => ScrollTrigger.refresh();
    requestAnimationFrame(settle);
    window.addEventListener('load', settle, { once: true });
  }
  });
</script>
