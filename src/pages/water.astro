---
import BaseLayout from '../layouts/BaseLayout.astro';
import Join from '../components/Join.astro';
import Journeys from '../components/Journeys.astro';
import RevealHeading from '../components/RevealHeading.astro';
---

<BaseLayout
  title="Thirst Contact | Aura Homes"
  description="Return to Aura. One beautiful room at a time."
  descriptor="Thirst Contact"
>
  <main id="top">
    <canvas class="page-field" data-wash="glass" aria-hidden="true"></canvas>
    <canvas class="field-light" data-field="glass" aria-hidden="true"></canvas>

    <section class="page-lead">
      <p class="story-kicker">Thirst Contact</p>
      <RevealHeading as="h1" glow>
        Water <br />from the sky.
      </RevealHeading>
      <p class="story-lede">
        Thirst Contact pulls water from the sky and bottles it in the backyard. A standard atmospheric water generator sits on the roof, and a short bottling line sits inside the room.
      </p>
    </section>

    <section class="story-still">
      <figure class="story-figure">
        <img
          src="/film/water-roof.webp"
          alt="Dusk, black glass room in tall grass, a low collector flat on the roof, firs and a pale mountain."
          width="1248"
          height="832"
          decoding="async"
        />
      </figure>
      <div>
        <p class="story-kicker">The roof</p>
        <h3><span class="line-mask"><span class="line">A quiet machine.</span></span></h3>
        <p>A low unit on the roof. No tower, nothing your neighbours can see from the road, and the meadow is still the view.</p>
      </div>
    </section>

    <section class="story-still is-flip">
      <figure class="story-figure">
        <video data-poster="/media/video/water-line-poster.webp" data-film="/media/video/water-line.mp4" data-film-webm="/media/video/water-line.webm" data-still="poster" muted loop playsinline preload="none" disablepictureinpicture width="1920" height="1280" data-shot="drift" data-play="glide" aria-label="Small bottling line and plain plastic jugs inside the oak room"></video>
      </figure>
      <div>
        <p class="story-kicker">The line</p>
        <h3><span class="line-mask"><span class="line">A bottling line, indoors.</span></span></h3>
        <p>A short stainless line fills plastic jugs. Bottling for yourself? Leave them plain.</p>
      </div>
    </section>

    <section class="ways">
      <p class="story-kicker">What the water unit is for</p>
      <ol>
        <li><span>01</span> An atmospheric water generator on the roof</li>
        <li><span>02</span> A micro bottling line</li>
        <li><span>03</span> Plastic jugs, plain or labelled</li>
        <li><span>04</span> The room still livable around the line</li>
      </ol>
      <p class="story-lede">How much water you get depends on humidity, power and local rules, so we do not quote numbers.</p>
    </section>

    <section class="story-open">
      <p class="story-kicker">The backyard</p>
      <RevealHeading as="h2" glow>
        Bottled <br />in the backyard.
      </RevealHeading>
      <p class="story-lede">
        Make your own water and bottle it for yourself. The bigger plan, a free water network, is a future expansion of the Aura network.
      </p>
      <p class="story-lede"><a href="/journal/water-from-the-air">Read the water note</a>, and <a href="/journal/free-food-and-water">the network</a>.</p>
    </section>

    <Journeys reveal />

    <section id="enquire" class="enquire">
      <p class="story-kicker">Enquire</p>
      <RevealHeading as="h2" glow>Want water from the sky?</RevealHeading>
      <p class="story-lede enquire-note">Leave your name and you are on the waitlist. No payment, no order, just first in line when builds open.</p>
      <Join shell="water" />
    </section>
  </main>
  <script>
    import { bindJourneyMotion } from '../scripts/journey';
    import { onPageLoad } from '../scripts/motion';
    onPageLoad(() => bindJourneyMotion());
  </script>
</BaseLayout>
