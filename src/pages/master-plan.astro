---
import Still from '../components/Still.astro';
import RevealHeading from '../components/RevealHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Master plan | Aura Homes"
  description="Beautiful second-life rooms that bring people back to nature, one room at a time."
  descriptor="Master plan"
>
  <main id="top" class="plan">
    <section class="page-lead">
      <div data-rise>
        <p class="story-kicker">Master plan</p>
        <RevealHeading as="h1">A plan, told slowly.</RevealHeading>
        <p class="story-lede">
          The room is what you can ask for now. Everything after it is a direction, held lightly.
        </p>
      </div>
    </section>

    <div class="plan-track">
      <div class="plan-spine" aria-hidden="true"></div>
      <ol class="plan-rail">
        <li class="plan-step" data-rise>
          <div class="plan-mark">
            <p class="plan-num" aria-hidden="true">01</p>
            <span class="plan-node" aria-hidden="true"></span>
          </div>
          <div class="plan-copy">
            <p class="story-kicker">Now</p>
            <RevealHeading as="h2"><span class="plan-keep">Second-life</span> rooms.</RevealHeading>
            <p>
              Beautiful second-life rooms, Hot Take tub units, and customs, made one at a time. Off-grid and solar builds are available.
            </p>
            <p class="plan-links">
              <a href="/rooms">Rooms</a>
              <a href="/pre-order?model=hot-take">Hot Take</a>
              <a href="/customs">Customs</a>
            </p>
          </div>
        </li>

        <li class="plan-step" data-rise>
          <div class="plan-mark">
            <p class="plan-num" aria-hidden="true">02</p>
            <span class="plan-node" aria-hidden="true"></span>
          </div>
          <div class="plan-copy">
            <p class="story-kicker">Grow</p>
            <RevealHeading as="h2">Rooms that would grow.</RevealHeading>
            <p>
              Root Access grow rooms and aeroponic units would follow, as Aura Farms. The same room, with one long side turned toward a living wall.
            </p>
            <p class="plan-links">
              <a href="/farms">Aura Farms</a>
            </p>
          </div>
        </li>

        <li class="plan-step" data-rise>
          <div class="plan-mark">
            <p class="plan-num" aria-hidden="true">03</p>
            <span class="plan-node" aria-hidden="true"></span>
          </div>
          <div class="plan-copy">
            <p class="story-kicker">Water</p>
            <RevealHeading as="h2">Drawn from the air.</RevealHeading>
            <p>
              Atmospheric water units would come later, after more research, and they are not ready to place. Aura H2O would be offered in premium cans and glass. Sponsors are ethical only. We decide who's in.
            </p>
            <p class="plan-later">Coming later.</p>
            <p class="plan-links">
              <a href="/water">Water</a>
            </p>
          </div>
        </li>

        <li class="plan-step" data-rise>
          <div class="plan-mark">
            <p class="plan-num" aria-hidden="true">04</p>
            <span class="plan-node" aria-hidden="true"></span>
          </div>
          <div class="plan-copy">
            <p class="story-kicker">Give</p>
            <RevealHeading as="h2">An intention to share.</RevealHeading>
            <p>
              The hope is free food and free water, beginning with food banks and anyone in need in Edmonton. It is an intention, not a promise, and it is not operating.
            </p>
            <p>
              The Aura host network. We'll provide the location, logistics, and support. Hosts get paid through the network.
            </p>
            <p>
              Seed pods, swaps, pickup, delivery, and repairs would be handled through the network.
            </p>
            <p class="plan-later">Coming later.</p>
            <p class="plan-links">
              <a href="/journal/free-food-and-water">The note</a>
            </p>
            <p class="plan-host-ask">
              <a href="/contact?topic=hosting">Interested in hosting? Tell us</a>
            </p>
          </div>
        </li>

        <li class="plan-step plan-stay">
          <div class="plan-stay-head" data-rise>
            <div class="plan-mark">
              <p class="plan-num" aria-hidden="true">05</p>
              <span class="plan-node" aria-hidden="true"></span>
            </div>
            <div class="plan-copy">
              <p class="story-kicker">Stay</p>
              <RevealHeading as="h2">Near the mountains.</RevealHeading>
              <p>
                Micro-resorts, about half an hour from Banff and Canmore, would be built as showcases for the newest rooms.
              </p>
              <p class="plan-later">Coming later.</p>
            </div>
          </div>

          <div class="stay-reel">
            <section class="stay-frame stay-moon" aria-labelledby="stay-moon">
              <Still
                src="/film/resort-deck.webp"
                alt="Stairs rising through snow to a lit mountain deck, the sky a deep blue."
              />
              <div class="stay-shade" aria-hidden="true"></div>
              <div class="stay-line" data-rise>
                <p class="stay-kicker">Coming later.</p>
                <h3 id="stay-moon">You walk up to the deck as the moon comes out.</h3>
              </div>
            </section>

            <section class="stay-frame stay-net" aria-labelledby="stay-net">
              <Still
                src="/film/resort-tower.webp"
                alt="A round glass tower in snow, mesh balconies stacked up its side."
              />
              <div class="stay-shade" aria-hidden="true"></div>
              <div class="stay-line" data-rise>
                <h3 id="stay-net">Outdoor blankets, pulled onto the net.</h3>
              </div>
            </section>

            <section class="stay-frame stay-tub" aria-labelledby="stay-tub">
              <Still
                src="/film/story-meadow-side.webp"
                alt="A wood-fired tub letting off steam beside an open room at dusk."
              />
              <div class="stay-shade" aria-hidden="true"></div>
              <div class="stay-line" data-rise>
                <h3 id="stay-tub">The wood-fired tub, lit.</h3>
              </div>
            </section>

            <section class="stay-frame stay-glow" aria-labelledby="stay-glow">
              <Still
                src="/film/story-room.webp"
                alt="An open oak and linen room facing a green field at dusk."
              />
              <div class="stay-shade" aria-hidden="true"></div>
              <div class="stay-line" data-rise>
                <h3 id="stay-glow">The underlit patio glows.</h3>
              </div>
            </section>

            <section class="stay-frame stay-inside" aria-labelledby="stay-inside">
              <Still
                src="/film/layout-night.webp"
                alt="A made bed under a skylight of stars, the room left quiet."
              />
              <div class="stay-shade" aria-hidden="true"></div>
              <div class="stay-line" data-rise>
                <h3 id="stay-inside">Chocolates, waiting inside.</h3>
              </div>
            </section>

            <section class="stay-frame stay-fire" data-zoom="1.58" aria-labelledby="stay-fire">
              <Still
                src="/film/resort-deck.webp"
                alt="A small fire already burning on the deck, beside the lounge."
              />
              <div class="stay-shade" aria-hidden="true"></div>
              <div class="stay-line" data-rise>
                <h3 id="stay-fire">A little fire, already going.</h3>
              </div>
            </section>
          </div>

          <div class="plan-stay-note" data-rise>
            <p>It would be catered, and left for you. No staff on site.</p>
            <p>Add-ons would come later. A side-by-side, if you want to go farther.</p>
            <p class="plan-links">
              <a href="/resorts">Resorts</a>
            </p>
          </div>
        </li>

        <li class="plan-step" data-rise>
          <div class="plan-mark">
            <p class="plan-num" aria-hidden="true">06</p>
            <span class="plan-node" aria-hidden="true"></span>
          </div>
          <div class="plan-copy">
            <p class="story-kicker">Paradise</p>
            <RevealHeading as="h2">Costa Rica, our second home.</RevealHeading>
            <p>
              Building in harmony with nature comes easier there. The same care would go there when the work is ready.
            </p>
          </div>
        </li>

        <li class="plan-step" data-rise>
          <div class="plan-mark">
            <p class="plan-num" aria-hidden="true">07</p>
            <span class="plan-node" aria-hidden="true"></span>
          </div>
          <div class="plan-copy">
            <p class="story-kicker">Home</p>
            <RevealHeading as="h2">Full eco homes, someday.</RevealHeading>
            <p>
              Whole houses would come last, after the rooms have taught the rest. Still quiet, and still close to the ground.
            </p>
          </div>
        </li>
      </ol>
    </div>

    <p class="plan-close" data-rise>One room at a time. Then a little more.</p>
  </main>
</BaseLayout>

<style>
  .plan {
    color: #14120e;
  }
  .plan-track {
    position: relative;
    padding: 2vh 8vw 4vh;
  }
  .plan-spine {
    position: absolute;
    z-index: 0;
    top: 6vh;
    bottom: 8vh;
    left: calc(8vw + 6.25rem);
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(156, 122, 85, 0.55) 10%,
      rgba(156, 122, 85, 0.55) 90%,
      transparent
    );
    transform-origin: top center;
    pointer-events: none;
  }
  .plan-rail {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .plan-step {
    position: relative;
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 38rem);
    column-gap: 3rem;
    align-items: start;
    padding: 11vh 0;
  }
  .plan-mark {
    position: relative;
  }
  .plan-num {
    margin: 0;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(1.7rem, 2.6vw, 2.35rem);
    line-height: 1;
    letter-spacing: 0.06em;
    color: #9c7a55;
  }
  .plan-node {
    position: absolute;
    z-index: 1;
    top: 0.48rem;
    right: -3.5px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #f4f3ef;
    box-shadow: 0 0 0 1px #9c7a55;
  }
  :global(.plan-copy h2) {
    margin: 0.85rem 0 0;
    max-width: 11em;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(2.35rem, 4.8vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .plan-keep {
    white-space: nowrap;
  }
  .plan-copy > p {
    max-width: 34rem;
    margin: 1.6rem 0 0;
    font-weight: 300;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(20, 18, 14, 0.78);
  }
  .plan-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin-top: 1.75rem;
  }
  .plan-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: #866243;
    transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .plan-links a:hover {
    opacity: 0.55;
  }
  .plan-later {
    margin: 1.75rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #866243;
  }
  .plan-host-ask {
    margin-top: 1.15rem;
  }
  .plan-host-ask a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    text-transform: none;
    text-decoration: underline;
    text-decoration-color: rgba(134, 98, 67, 0.7);
    text-underline-offset: 0.22em;
    color: #866243;
    transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .plan-host-ask a:hover {
    opacity: 0.55;
  }
  .plan-stay {
    display: block;
    padding-bottom: 0;
  }
  .plan-stay-head {
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 38rem);
    column-gap: 3rem;
    align-items: start;
  }
  .stay-reel {
    position: relative;
    z-index: 1;
    margin: 10vh 0 0 -8vw;
    width: calc(100% + 16vw);
  }
  .stay-frame {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: #0c0d0e;
    color: #f4f3ef;
  }
  .stay-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform-origin: center center;
  }
  .stay-moon img {
    object-position: 50% 42%;
  }
  .stay-net img {
    object-position: 50% 70%;
  }
  .stay-glow img {
    object-position: 62% 84%;
  }
  .stay-glow .stay-shade {
    background: linear-gradient(
      to top,
      rgba(12, 13, 14, 0.4) 0%,
      rgba(12, 13, 14, 0.1) 34%,
      rgba(12, 13, 14, 0.26) 100%
    );
  }
  .stay-glow .stay-line::before {
    background: linear-gradient(
      to top,
      rgba(12, 13, 14, 0.58) 0%,
      rgba(12, 13, 14, 0.22) 58%,
      rgba(12, 13, 14, 0) 100%
    );
  }
  .stay-fire img {
    object-position: 84% 62%;
    transform: scale(1.58);
    transform-origin: 84% 62%;
  }
  .stay-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(12, 13, 14, 0.78) 0%,
      rgba(12, 13, 14, 0.42) 24%,
      rgba(12, 13, 14, 0.05) 52%,
      rgba(12, 13, 14, 0.34) 100%
    );
    pointer-events: none;
  }
  .stay-line {
    position: absolute;
    z-index: 1;
    left: 8vw;
    right: 8vw;
    bottom: 11vh;
    margin-left: calc(6.25rem + 3rem);
  }
  .stay-line::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: -50vw;
    right: -30vw;
    top: -16vh;
    bottom: -14vh;
    background: linear-gradient(
      to top,
      rgba(12, 13, 14, 0.88) 0%,
      rgba(12, 13, 14, 0.55) 48%,
      rgba(12, 13, 14, 0) 100%
    );
    pointer-events: none;
  }
  .stay-kicker {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #c4a07a;
  }
  .stay-line h3 {
    margin: 0;
    max-width: 11em;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(2.2rem, 4.8vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: #f4f3ef;
  }
  .plan-stay-note {
    max-width: 34rem;
    margin: 10vh 0 6vh calc(6.25rem + 3rem);
  }
  .plan-stay-note p {
    margin: 0 0 1rem;
    font-weight: 300;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(20, 18, 14, 0.78);
  }
  .plan-stay-note .plan-links {
    margin-top: 1.5rem;
  }
  .plan-close {
    margin: 8vh 8vw 20vh calc(8vw + 6.25rem + 3rem);
    max-width: 12em;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(2.1rem, 4.6vw, 3.8rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  @media (max-width: 800px) {
    .plan-track {
      padding: 0 1.5rem 2vh;
    }
    .plan-spine {
      left: calc(1.5rem + 0.15rem);
      top: 4vh;
      bottom: 4vh;
    }
    .plan-step {
      grid-template-columns: 1fr;
      row-gap: 1.15rem;
      padding: 8vh 0 8vh 1.65rem;
    }
    .plan-mark {
      position: static;
    }
    .plan-node {
      top: calc(8vh + 0.42rem);
      right: auto;
      left: 0.15rem;
      transform: translateX(-50%);
    }
    .plan-stay {
      padding: 8vh 0 0 1.65rem;
    }
    .plan-stay-head {
      grid-template-columns: 1fr;
      row-gap: 1.15rem;
    }
    .stay-reel {
      margin: 8vh 0 0 calc(-1.5rem - 1.65rem);
      width: calc(100% + 3rem + 1.65rem);
    }
    .stay-line {
      left: 1.5rem;
      right: 1.5rem;
      bottom: 8vh;
      margin-left: 0;
    }
    .plan-stay-note {
      margin: 8vh 0 4vh 0;
    }
    .plan-close {
      margin: 5vh 1.5rem 16vh 3.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plan-links a,
    .plan-host-ask a {
      transition: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion, onPageLoad } from '../scripts/motion';

  onPageLoad(() => {

  const page = document.querySelector('.plan');
  if (page && !prefersReducedMotion()) {
    ScrollTrigger.getAll()
      .filter((trigger) => trigger.vars.id === 'plan-rise')
      .forEach((trigger) => trigger.kill());

    gsap.utils.toArray<HTMLElement>('.stay-frame img', page).forEach((img) => {
      const frame = img.closest<HTMLElement>('.stay-frame');
      if (!frame) return;
      const zoom = Number(frame.dataset.zoom || '1');
      const rest = Number.isFinite(zoom) && zoom > 0 ? zoom : 1;
      gsap.fromTo(
        img,
        { scale: rest * 1.06 },
        {
          scale: rest,
          ease: 'none',
          scrollTrigger: {
            id: 'plan-rise',
            trigger: frame,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1.6,
          },
        },
      );
    });

    gsap.utils.toArray<HTMLElement>('[data-rise]', page).forEach((el) => {
      gsap.from(el, {
        y: 22,
        opacity: 0,
        duration: 1.85,
        ease: 'power3.out',
        scrollTrigger: {
          id: 'plan-rise',
          trigger: el,
          start: 'top 90%',
          once: true,
        },
      });
    });

    const settle = () => ScrollTrigger.refresh();
    requestAnimationFrame(settle);
    window.addEventListener('load', settle, { once: true });
  }
  });
</script>
