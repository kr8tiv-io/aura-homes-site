---
import RevealHeading from '../components/RevealHeading.astro';
import Still from '../components/Still.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Master plan | Aura Homes"
  description="Return to Aura. One beautiful room at a time."
  descriptor="Master plan"
>
  <main id="top" class="plan">
    <section class="page-lead">
      <div data-rise>
        <p class="story-kicker">Master plan</p>
        <RevealHeading as="h1">A plan, told slowly.</RevealHeading>
        <p class="story-lede">
          The room is what you can ask for now. Everything after it is a direction, held lightly.
        </p>
      </div>
    </section>

    <section class="plan-journey" data-plan-journey aria-label="Chapters">
      <div class="plan-progress" aria-hidden="true">
        <div class="plan-progress-track" data-plan-track>
          <div class="plan-progress-fill" data-plan-line></div>
          <span class="plan-halo" data-plan-halo>
            <span class="plan-halo-glow"></span>
            <span class="plan-halo-dot"></span>
          </span>
        </div>
      </div>

      <ol class="plan-rail" data-plan-rail>
        <li class="plan-panel" data-plan-panel>
          <div class="plan-photo">
            <Still
              src="/film/story-meadow-side.webp"
              alt="A glass room open to a meadow at dusk, a wood-fired tub steaming beside it."
              position="center 64%"
              phonePosition="36% center"
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="plan-shade" aria-hidden="true"></div>
          <p class="plan-giant" aria-hidden="true">
            <span class="plan-giant-outline">01</span>
            <span class="plan-giant-clip" data-plan-num><span class="plan-giant-solid">01</span></span>
          </p>
          <div class="plan-copy">
            <p class="story-kicker">Now</p>
            <RevealHeading as="h2"><span class="plan-keep">Second-life</span> rooms.</RevealHeading>
            <p>
              Beautiful second-life rooms, Hot Take tub units, and customs, made one at a time. Off-grid and solar builds are available.
            </p>
            <p class="plan-links">
              <a href="/rooms">Rooms</a>
              <a href="/pre-order?model=hot-take">Hot Take</a>
              <a href="/customs">Customs</a>
            </p>
          </div>
        </li>

        <li class="plan-panel" data-plan-panel>
          <div class="plan-photo">
            <Still
              src="/film/farm-wall.webp"
              alt="A black glass room in a dusk meadow, one wall a vertical garden glowing from within."
              phonePosition="center 46%"
              sizes="100vw"
            />
          </div>
          <div class="plan-shade" aria-hidden="true"></div>
          <p class="plan-giant" aria-hidden="true">
            <span class="plan-giant-outline">02</span>
            <span class="plan-giant-clip" data-plan-num><span class="plan-giant-solid">02</span></span>
          </p>
          <div class="plan-copy">
            <p class="story-kicker">Grow</p>
            <RevealHeading as="h2">Rooms that would grow.</RevealHeading>
            <p>
              Leaf Skywalker grow rooms and aeroponic units would follow, as Aura Farms. The same room, with one long side turned toward a living wall.
            </p>
            <p class="plan-links">
              <a href="/farms">Aura Farms</a>
            </p>
          </div>
        </li>

        <li class="plan-panel" data-plan-panel>
          <div class="plan-photo">
            <Still
              src="/film/water-line.webp"
              alt="A wood room at dusk, water filling glass jugs beside a meadow window."
              phonePosition="28% center"
              sizes="100vw"
            />
          </div>
          <div class="plan-shade" aria-hidden="true"></div>
          <p class="plan-giant" aria-hidden="true">
            <span class="plan-giant-outline">03</span>
            <span class="plan-giant-clip" data-plan-num><span class="plan-giant-solid">03</span></span>
          </p>
          <div class="plan-copy">
            <p class="story-kicker">Water</p>
            <RevealHeading as="h2">Drawn from the air.</RevealHeading>
            <p>
              Thirst Contact, water drawn from the air, would come later, after more research. It is not ready to place.
            </p>
            <p class="plan-later">Coming later.</p>
            <p class="plan-links">
              <a href="/water">Water</a>
            </p>
          </div>
        </li>

        <li class="plan-panel" data-plan-panel>
          <div class="plan-photo">
            <Still
              src="/film/layout-lounge-wind.webp"
              alt="A linen sofa in a warm wood room, evening light along the ceiling, a meadow beyond the glass."
              position="28% center"
              phonePosition="32% center"
              sizes="100vw"
            />
          </div>
          <div class="plan-shade" aria-hidden="true"></div>
          <p class="plan-giant" aria-hidden="true">
            <span class="plan-giant-outline">04</span>
            <span class="plan-giant-clip" data-plan-num><span class="plan-giant-solid">04</span></span>
          </p>
          <div class="plan-copy">
            <p class="story-kicker">Later</p>
            <RevealHeading as="h2">A network, not yet.</RevealHeading>
            <p>
              A host network for placing rooms is an idea for later.
            </p>
            <p>
              Location and care of the rooms would be part of that network if it is ever built. The network is not open.
            </p>
            <p>
              Seed pods, swaps, pickup, delivery, and repairs would be handled through the network.
            </p>
            <p class="plan-later">Coming later.</p>
            <p class="plan-links">
              <a href="/journal/free-food-and-water">The note</a>
            </p>
            <p class="plan-host-ask">
              <a href="/contact?topic=hosting">Interested in hosting? Tell us</a>
            </p>
          </div>
        </li>

        <li class="plan-panel plan-panel-stay" data-plan-panel data-resort-night>
          <div class="plan-photo">
            <Still
              src="/media/specialty/aframe-aerial-blue-hour-snow.jpg"
              alt="An A-frame with a lit glass deck in a snowy pine valley at blue hour, stairs rising from the snow, a river and mountains beyond."
              position="50% 42%"
              phonePosition="center 38%"
              sizes="100vw"
            />
          </div>
          <div class="night-glow" data-night-glow aria-hidden="true"></div>
          <div class="plan-shade" aria-hidden="true"></div>
          <div class="night-sky" data-night-sky aria-hidden="true"></div>
          <canvas class="night-stars" data-night-stars aria-hidden="true"></canvas>
          <div class="night-moon" data-night-moon aria-hidden="true">
            <span class="night-moon-halo"></span>
            <span class="night-moon-disc"></span>
          </div>
          <div class="night-steam" data-night-steam aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
          <p class="plan-giant" aria-hidden="true">
            <span class="plan-giant-outline">05</span>
            <span class="plan-giant-clip" data-plan-num><span class="plan-giant-solid">05</span></span>
          </p>
          <div class="plan-copy">
            <p class="story-kicker">Stay</p>
            <RevealHeading as="h2">Near the mountains.</RevealHeading>
            <p>
              Micro-resorts, about half an hour from Banff and Canmore, would be built as showcases for the newest rooms.
            </p>
            <p class="plan-later">Coming later.</p>
            <p class="night-lines">
              <span data-night-line>You walk up to the deck.</span>
              <span data-night-line>Pull the blankets onto the net.</span>
              <span data-night-line>The water's ready.</span>
            </p>
            <p>It would be catered, and left for you. No staff on site.</p>
            <p>Add-ons would come later. A side-by-side, if you want to go farther.</p>
            <p class="plan-links">
              <a href="/resorts">Resorts</a>
            </p>
          </div>
        </li>

        <li class="plan-panel" data-plan-panel>
          <div class="plan-photo">
            <Still
              src="/film/costa-canopy.webp"
              alt="A glass room with a warm wood interior, set in a misty rainforest at dusk."
              phonePosition="center 42%"
              sizes="100vw"
            />
          </div>
          <div class="plan-shade" aria-hidden="true"></div>
          <p class="plan-giant" aria-hidden="true">
            <span class="plan-giant-outline">06</span>
            <span class="plan-giant-clip" data-plan-num><span class="plan-giant-solid">06</span></span>
          </p>
          <div class="plan-copy">
            <p class="story-kicker">Paradise</p>
            <RevealHeading as="h2">Costa Rica, our second home.</RevealHeading>
            <p>
              Building in harmony with nature comes easier there. The same care would go there when the work is ready.
            </p>
          </div>
        </li>

        <li class="plan-panel" data-plan-panel>
          <div class="plan-photo">
            <Still
              src="/film/layout-night.webp"
              alt="A made bed under a skylight of stars, a night meadow beyond the glass."
              position="center 68%"
              phonePosition="center 46%"
              sizes="100vw"
            />
          </div>
          <div class="plan-shade" aria-hidden="true"></div>
          <p class="plan-giant" aria-hidden="true">
            <span class="plan-giant-outline">07</span>
            <span class="plan-giant-clip" data-plan-num><span class="plan-giant-solid">07</span></span>
          </p>
          <div class="plan-copy">
            <p class="story-kicker">Home</p>
            <RevealHeading as="h2">Full eco homes, someday.</RevealHeading>
            <p>
              Whole houses would come last, after the rooms have taught the rest. Still quiet, and still close to the ground.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <p class="plan-close" data-rise>One room at a time. Then a little more.</p>
  </main>
</BaseLayout>

<style>
  .plan {
    color: #14120e;
  }
  .plan-journey {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: #0c0d0e;
    color: #f4f3ef;
  }
  .plan-progress {
    position: absolute;
    z-index: 5;
    top: 7.15rem;
    left: 8vw;
    right: 8vw;
    height: 1.4rem;
    pointer-events: none;
  }
  .plan-progress-track {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(244, 243, 239, 0.32);
  }
  .plan-progress-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    background: #c4a07a;
    transform: scaleX(0);
    transform-origin: left center;
  }
  .plan-halo {
    position: absolute;
    top: 50%;
    left: 0;
    width: 13px;
    height: 13px;
    margin-top: -6.5px;
    margin-left: -6.5px;
  }
  .plan-halo-glow,
  .plan-halo-dot {
    position: absolute;
    border-radius: 50%;
  }
  .plan-halo-glow {
    inset: -4px;
    box-shadow:
      0 0 0 1px rgba(12, 13, 14, 0.78),
      0 0 0 4px rgba(12, 13, 14, 0.28),
      0 0 14px rgba(12, 13, 14, 0.45);
  }
  .plan-halo-dot {
    inset: 1px;
    background: #c4a07a;
    box-shadow: 0 0 0 1px rgba(244, 243, 239, 0.4);
  }
  .plan-rail {
    display: flex;
    height: 100%;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .plan-panel {
    position: relative;
    flex: 0 0 100vw;
    width: 100vw;
    height: 100%;
    overflow: hidden;
  }
  .plan-photo {
    position: absolute;
    inset: 0;
  }
  .plan-photo :global(picture.still-frame) {
    position: absolute;
    inset: 0;
  }
  .plan-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12, 13, 14, 0.78) 0%, rgba(12, 13, 14, 0.42) 42%, rgba(12, 13, 14, 0.12) 100%),
      linear-gradient(180deg, rgba(12, 13, 14, 0.42) 0%, rgba(12, 13, 14, 0.08) 30%, rgba(12, 13, 14, 0.46) 100%);
    pointer-events: none;
  }
  .plan-giant {
    position: absolute;
    z-index: 1;
    right: -0.04em;
    bottom: -0.08em;
    margin: 0;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(6.5rem, 18vw, 15.5rem);
    line-height: 0.78;
    letter-spacing: -0.045em;
    pointer-events: none;
    user-select: none;
  }
  .plan-giant-outline,
  .plan-giant-solid {
    display: block;
    white-space: nowrap;
  }
  .plan-giant-outline {
    color: transparent;
    -webkit-text-stroke: 1.25px rgba(244, 243, 239, 0.78);
  }
  .plan-giant-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform: scaleX(0);
    transform-origin: left center;
  }
  .plan-giant-solid {
    position: absolute;
    left: 0;
    top: 0;
    color: #f4f3ef;
    -webkit-text-stroke: 0;
  }
  .plan-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-sizing: border-box;
    width: min(32rem, 44vw);
    height: 100%;
    margin: 0;
    padding: 8.5rem 0 7vh 8vw;
  }
  .plan-copy .story-kicker {
    color: #c4a07a;
  }
  .plan-copy :global(h2) {
    margin: 0.7rem 0 0;
    max-width: 11em;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(2.05rem, 3.6vw, 3.45rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: #f4f3ef;
  }
  .plan-keep {
    white-space: nowrap;
  }
  .plan-copy > p {
    max-width: 32rem;
    margin: 0.7rem 0 0;
    font-weight: 300;
    font-size: 1.02rem;
    line-height: 1.5;
    color: rgba(244, 243, 239, 0.84);
  }
  .plan-panel-stay .plan-shade {
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(12, 13, 14, 0.74) 0%, rgba(12, 13, 14, 0.34) 34%, rgba(12, 13, 14, 0.08) 58%, rgba(12, 13, 14, 0) 100%),
      linear-gradient(180deg, rgba(12, 13, 14, 0.06) 0%, rgba(12, 13, 14, 0) 24%, rgba(12, 13, 14, 0.32) 100%);
  }
  .night-glow,
  .night-sky,
  .night-stars,
  .night-moon,
  .night-steam {
    position: absolute;
    pointer-events: none;
  }
  .night-glow {
    z-index: 1;
    inset: 0;
    opacity: 0;
    mix-blend-mode: screen;
    background:
      radial-gradient(ellipse 46% 20% at 56% 62%, rgba(255, 186, 110, 0.5), transparent 70%),
      radial-gradient(ellipse 22% 14% at 27% 52%, rgba(255, 210, 160, 0.34), transparent 68%),
      radial-gradient(ellipse 38% 16% at 48% 84%, rgba(255, 170, 90, 0.26), transparent 72%);
  }
  .night-sky {
    z-index: 2;
    inset: 0;
    opacity: 0;
    background: linear-gradient(
      180deg,
      rgba(5, 8, 16, 0.92) 0%,
      rgba(7, 12, 24, 0.66) 20%,
      rgba(8, 14, 26, 0.2) 40%,
      rgba(8, 14, 26, 0) 54%
    );
  }
  .night-stars {
    z-index: 2;
    top: 0;
    left: 0;
    width: 100%;
    height: 42%;
  }
  .night-moon {
    z-index: 3;
    left: 74%;
    top: 10.4rem;
    width: 5.5rem;
    height: 5.5rem;
    opacity: 0;
    will-change: transform, opacity;
  }
  .night-moon-halo,
  .night-moon-disc {
    position: absolute;
    border-radius: 50%;
  }
  .night-moon-halo {
    inset: -34%;
    background: radial-gradient(circle, rgba(244, 243, 239, 0.42) 0%, rgba(244, 243, 239, 0.1) 40%, transparent 68%);
  }
  .night-moon-disc {
    inset: 22%;
    background: #f4f3ef;
    box-shadow: 0 0 0 1px rgba(12, 13, 14, 0.35);
  }
  .night-steam {
    z-index: 3;
    left: 23%;
    top: 40%;
    width: 16rem;
    height: 12rem;
  }
  .night-steam span {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 50% 62%,
      rgba(244, 243, 239, 0.72),
      rgba(244, 243, 239, 0.16) 46%,
      transparent 72%
    );
    filter: blur(14px);
    opacity: 0;
    will-change: transform, opacity;
  }
  .night-steam span:nth-child(1) {
    left: 22%;
    bottom: 0;
    width: 5.6rem;
    height: 4.4rem;
  }
  .night-steam span:nth-child(2) {
    left: 40%;
    bottom: 16%;
    width: 4.4rem;
    height: 6.2rem;
    filter: blur(16px);
  }
  .night-steam span:nth-child(3) {
    left: 6%;
    bottom: 8%;
    width: 6.4rem;
    height: 5rem;
    filter: blur(18px);
  }
  .night-steam span:nth-child(4) {
    left: 50%;
    bottom: 30%;
    width: 3.6rem;
    height: 5.4rem;
    filter: blur(12px);
  }
  .night-steam span:nth-child(5) {
    left: 28%;
    bottom: 38%;
    width: 5rem;
    height: 4.2rem;
    filter: blur(20px);
  }
  .plan-panel-stay .plan-giant {
    z-index: 3;
  }
  .plan-panel-stay .plan-copy {
    z-index: 4;
  }
  .night-lines {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    max-width: 18rem;
    margin-top: 0.85rem;
  }
  .night-lines span {
    display: block;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(1.12rem, 1.6vw, 1.38rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
    color: #f4f3ef;
    opacity: 0;
    will-change: transform, opacity;
  }
  .plan-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.35rem;
    margin-top: 0.75rem;
  }
  .plan-links a,
  .plan-host-ask a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #c4a07a;
    text-decoration: none;
  }
  .plan-links a {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .plan-later {
    margin-top: 0.85rem;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #c4a07a;
  }
  .plan-host-ask {
    margin-top: 0.15rem;
  }
  .plan-host-ask a {
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .plan-close {
    margin: 12vh 8vw 18vh;
    max-width: 12em;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(2.1rem, 4.6vw, 3.8rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  @media (max-width: 800px), (prefers-reduced-motion: reduce) {
    .plan-journey {
      height: auto;
      overflow: visible;
    }
    .plan-progress {
      display: none;
    }
    .plan-rail {
      display: block;
      width: auto;
      height: auto;
      transform: none !important;
    }
    .plan-panel {
      width: 100%;
      flex: none;
      height: auto;
      min-height: 100svh;
    }
    .plan-giant {
      top: 11.25rem;
      right: -0.08em;
      bottom: auto;
      font-size: clamp(4.2rem, 28vw, 6.6rem);
    }
    .night-sky,
    .night-glow,
    .night-moon,
    .night-lines span {
      opacity: 1;
    }
    .night-steam span {
      opacity: 0.48;
    }
    .night-moon {
      left: 6%;
      top: 13.5rem;
    }
    .night-moon,
    .night-steam span,
    .night-lines span {
      will-change: auto;
    }
    .plan-giant-clip {
      transform: none;
    }
    .plan-copy {
      width: auto;
      height: auto;
      min-height: 100svh;
      justify-content: flex-end;
      padding: 7.4rem 1.5rem 2.6rem;
    }
    .plan-copy :global(h2) {
      font-size: clamp(2.15rem, 9vw, 3.1rem);
    }
    .plan-close {
      margin: 8vh 1.5rem 16vh;
    }
  }


</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion, onPageLoad, holdPageMotion } from '../scripts/motion';
  import { mountResortNight, type ResortNight } from '../scripts/resort-night';

  type PlanWindow = Window & { __auraPlan?: () => void };

  onPageLoad(() => {
    const page = document.querySelector<HTMLElement>('.plan');
    if (!page) return;

    const win = window as PlanWindow;
    win.__auraPlan?.();

    ScrollTrigger.getAll()
      .filter((trigger) => trigger.vars.id === 'plan-rise')
      .forEach((trigger) => trigger.kill());

    if (!prefersReducedMotion()) {
      gsap.utils.toArray<HTMLElement>('[data-rise]', page).forEach((el) => {
        gsap.from(el, {
          y: 22,
          opacity: 0,
          duration: 1.85,
          ease: 'power3.out',
          scrollTrigger: {
            id: 'plan-rise',
            trigger: el,
            start: 'top 90%',
            once: true,
          },
        });
      });
    }

    const journey = page.querySelector<HTMLElement>('[data-plan-journey]');
    const rail = page.querySelector<HTMLElement>('[data-plan-rail]');
    const track = page.querySelector<HTMLElement>('[data-plan-track]');
    const line = page.querySelector<HTMLElement>('[data-plan-line]');
    const halo = page.querySelector<HTMLElement>('[data-plan-halo]');
    const panels = gsap.utils.toArray<HTMLElement>('[data-plan-panel]', page);
    const mm = gsap.matchMedia();

    let night: ResortNight | null = null;
    let closed = false;
    const close = () => {
      if (closed) return;
      closed = true;
      mm.revert();
      night?.destroy();
      if (win.__auraPlan === close) win.__auraPlan = undefined;
    };
    win.__auraPlan = close;
    holdPageMotion(close);

    if (!journey || !rail || !track || !line || !halo || panels.length === 0) return;

    const stay = page.querySelector<HTMLElement>('[data-resort-night]');
    night = stay ? mountResortNight(stay) : null;

    mm.add('(min-width: 801px) and (prefers-reduced-motion: no-preference)', () => {
      const clips = panels.map((panel) => panel.querySelector<HTMLElement>('[data-plan-num]'));
      const stayIndex = Math.max(
        0,
        panels.findIndex((panel) => panel.hasAttribute('data-resort-night')),
      );
      let sized = 0;

      const panelWidth = () => {
        const width = journey.clientWidth;
        if (width !== sized) {
          sized = width;
          panels.forEach((panel) => {
            panel.style.width = `${width}px`;
            panel.style.flexBasis = `${width}px`;
          });
        }
        return width;
      };

      const travel = () => {
        const width = panelWidth();
        const before = stayIndex * width;
        const hold = Math.round(window.innerHeight * 2.7);
        const after = Math.max(0, panels.length - 1 - stayIndex) * width;
        return { width, before, hold, total: before + hold + after };
      };

      const paintNumbers = (chapter: number) => {
        const span = Math.max(1, panels.length - 1);
        const marker = chapter / span;
        clips.forEach((clip, index) => {
          if (!clip) return;
          const dist = Math.abs(marker - index / span);
          let local = 1 - Math.min(1, dist / (1.1 / span));
          local = local * local * (3 - 2 * local);
          gsap.set(clip, { scaleX: local, transformOrigin: '0% 50%' });
        });
      };

      const place = (progress: number) => {
        const { width, before, hold, total } = travel();
        const traveled = progress * total;
        let x = 0;
        let chapter = 0;
        let nightProgress = 0;
        if (traveled <= before || width === 0) {
          x = -traveled;
          chapter = width > 0 ? traveled / width : 0;
          nightProgress = 0;
        } else if (traveled <= before + hold) {
          x = -before;
          chapter = stayIndex;
          nightProgress = hold > 0 ? (traveled - before) / hold : 1;
        } else {
          const past = traveled - before - hold;
          x = -(before + past);
          chapter = stayIndex + (width > 0 ? past / width : 0);
          nightProgress = 1;
        }
        gsap.set(rail, { x });
        gsap.set(line, { scaleX: progress, transformOrigin: '0% 50%' });
        gsap.set(halo, { x: progress * track.clientWidth });
        paintNumbers(chapter);
        night?.setProgress(nightProgress);
      };

      panelWidth();
      ScrollTrigger.create({
        id: 'plan-journey',
        trigger: journey,
        start: 'top top',
        end: () => `+=${travel().total}`,
        pin: true,
        scrub: true,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        onUpdate: (self) => place(self.progress),
        onRefresh: (self) => place(self.progress),
      });
      place(0);

      const settle = () => {
        sized = 0;
        ScrollTrigger.refresh();
        window.__lenis?.resize();
      };
      requestAnimationFrame(settle);

      return () => {
        sized = 0;
        panels.forEach((panel) => {
          panel.style.width = '';
          panel.style.flexBasis = '';
        });
        gsap.set([rail, line, halo], { clearProps: 'transform' });
        clips.forEach((clip) => {
          if (clip) gsap.set(clip, { clearProps: 'transform' });
        });
        night?.setProgress(1);
      };
    });
  });
</script>
