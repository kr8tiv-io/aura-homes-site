---
import RevealHeading from '../components/RevealHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Build Your Own | Aura Homes"
  description="Return to Aura. One beautiful room at a time. Choose a model, a size, the glass, and the add-ons, then ask for a quote."
  descriptor="Build Your Own"
>
  <main id="top" class="byo-page">
    <header class="byo-head">
      <p class="story-kicker">Build your own</p>
      <RevealHeading as="h1">Build your own.</RevealHeading>
      <p class="story-lede">One beautiful room at a time. The meadow stays with the room while you choose.</p>
    </header>
    <div id="byo-root"></div>
  </main>
</BaseLayout>

<style>
  .byo-page {
    position: relative;
    z-index: 1;
    color: #14120e;
    background: #f4f3ef;
  }
  .byo-head {
    max-width: 46rem;
    padding: 8.5rem 8vw 2.5rem;
  }
  .byo-head :global(h1) {
    margin: 0;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(3rem, 7vw, 5.4rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .byo-head .story-lede {
    max-width: 32rem;
    margin-top: 1.2rem;
  }
  /* The configurator mounts after load. Hold the footer below the first screen. */
  #byo-root {
    min-height: 100svh;
  }
  @media (max-width: 800px) {
    .byo-head {
      padding: 7rem 1.5rem 2rem;
    }
  }
</style>

<script>
  import { onPageLoad, holdPageMotion } from '../scripts/motion';

  onPageLoad(() => {
    const root = document.getElementById('byo-root');
    if (!(root instanceof HTMLElement)) return;

    let booted = false;
    let gone = false;
    const host = root as HTMLElement & { __byo?: { unmount: () => void } };

    const ensureReactPreamble = async () => {
      if (!import.meta.env.DEV) return;
      const win = window as Window & {
        $RefreshReg$?: () => void;
        $RefreshSig$?: () => (type: unknown) => unknown;
      };
      if (win.$RefreshReg$) return;
      const runtime = (await import(/* @vite-ignore */ '/@react-refresh')) as {
        injectIntoGlobalHook: (target: Window) => void;
      };
      runtime.injectIntoGlobalHook(window);
      win.$RefreshReg$ = () => {};
      win.$RefreshSig$ = () => (type) => type;
    };

    const load = () => {
      if (gone || booted) return;
      booted = true;
      ensureReactPreamble()
        .then(() => import('../builder/mount'))
        .then(({ mountBuilder }) => {
          if (gone) return;
          mountBuilder(root);
        })
        .catch(() => {
          booted = false;
        });
    };

    if (document.readyState === 'complete') load();
    else window.addEventListener('load', load, { once: true });

    holdPageMotion(() => {
      gone = true;
      window.removeEventListener('load', load);
      const dropping = host.__byo;
      delete host.__byo;
      if (dropping) {
        window.setTimeout(() => {
          try {
            dropping.unmount();
          } catch {
            /* The root is leaving with the page. */
          }
        }, 0);
      }
    });
  });
</script>
