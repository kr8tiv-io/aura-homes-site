---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Aura Homes | Contact"
  description="Write to Aura Homes. Email and phone are not set yet. Edmonton, Alberta. Shipping across Canada."
  descriptor="Contact"
>
  <main id="top">
    <section class="page-lead">
      <p class="story-kicker">Contact</p>
      <h1>Write to us.</h1>
      <p class="story-lede">
        The room starts with the land. Tell us where it is when these lines are live. Until then, the address and the number are placeholders.
      </p>
    </section>
    <div class="page-body">
      <p class="todo-line">Email: TODO</p>
      <p class="todo-line">Phone: TODO</p>
      <p>Edmonton, Alberta. Shipping across Canada.</p>
      <p>If you only want your name held, use <a href="/pre-order">Pre-order</a>. That form takes no payment. Shorter answers are on the <a href="/faq">FAQ</a>.</p>
    </div>
  </main>
</BaseLayout>
