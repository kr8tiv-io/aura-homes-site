---
import RevealHeading from '../components/RevealHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { contactEmail, contactPhone, formAction, httpsUrl, phoneTel, youtubeUrl } from '../data/site';

const action = formAction();
const email = contactEmail.trim();
const phone = contactPhone.trim();
const tel = phoneTel(phone);
const youtube = httpsUrl(youtubeUrl);

const topics = [
  ['quote', 'Quote'],
  ['custom-build', 'Custom build'],
  ['hosting', 'Hosting'],
  ['partnership', 'Partnership'],
  ['press', 'Press'],
  ['other', 'Other'],
] as const;
---

<BaseLayout
  title="Contact | Aura Homes"
  description="Questions, ideas, hosting, partnerships. We read everything."
  descriptor="Contact"
>
  <main id="top" class="contact-page">
    <section class="page-lead">
      <p class="story-kicker">Contact</p>
      <RevealHeading as="h1">Write to us.</RevealHeading>
      <p class="story-lede">Questions, ideas, hosting, partnerships. We read everything.</p>
    </section>

    <section class="enquire" id="write">
      <form class="join-card contact-form" id="contact-form" action={action} method="post">
        <input class="join-hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="contact-grid">
          <div class="field">
            <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="80" placeholder=" " />
            <label for="contact-name">Name</label>
            <span class="field-glow" aria-hidden="true"></span>
          </div>
          <div class="field">
            <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="120" placeholder=" " />
            <label for="contact-email">Email</label>
            <span class="field-glow" aria-hidden="true"></span>
          </div>
          <div class="field is-wide">
            <select id="contact-topic" name="topic" required>
              <option value="" selected disabled>Choose one</option>
              {topics.map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
            <label for="contact-topic">Topic</label>
            <span class="field-glow" aria-hidden="true"></span>
          </div>
          <div class="field is-wide">
            <textarea id="contact-message" name="message" required maxlength="2000" placeholder=" "></textarea>
            <label for="contact-message">Message</label>
            <span class="field-glow" aria-hidden="true"></span>
          </div>
        </div>
        <button type="submit" class="is-slide"><span class="slide-face"><span class="slide-line">Send the note</span><span class="slide-line" aria-hidden="true">Send the note</span></span></button>
        <p class="join-status" data-contact-status role="status"><span data-status-line></span></p>
      </form>

      <div class="join-card contact-thanks" id="contact-thanks" hidden>
        <RevealHeading as="h2" tabindex="-1">We have your note.</RevealHeading>
        <p data-sent-host><span data-contact-thanks-line>We read everything.</span></p>
      </div>
      <div class="join-card contact-thanks" id="contact-draft" hidden>
        <RevealHeading as="h2" tabindex="-1">Your draft is ready.</RevealHeading>
        <p>Your draft is ready to send.</p>
      </div>
    </section>

    <div class="page-body contact-reach">
      {email && <p class="todo-line"><a href={`mailto:${email}`}>Email: {email}</a></p>}
      {phone && tel && <p class="todo-line"><a href={tel}>Phone: {phone}</a></p>}
      {phone && !tel && <p class="todo-line">Phone: {phone}</p>}
      <p>Edmonton, Alberta. Shipping across Canada.</p>
      {youtube && <p class="contact-yt"><a href={youtube}>Follow the build on YouTube</a></p>}
      <p>
        If you only want your name held, use <a href="/pre-order">Pre-order</a>. That form takes no payment.
        Shorter answers are on the <a href="/faq">FAQ</a>.
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .contact-page .enquire {
    min-height: 0;
    justify-content: flex-start;
    padding: 6vh 8vw 8vh;
  }
  .contact-form,
  .contact-thanks {
    width: min(100%, 46rem);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 1.25rem;
  }
  .contact-grid .is-wide {
    grid-column: 1 / -1;
  }
  .contact-form select {
    padding-right: 2rem;
    background-image:
      linear-gradient(45deg, transparent 50%, #c4a07a 50%),
      linear-gradient(135deg, #c4a07a 50%, transparent 50%);
    background-position:
      calc(100% - 1.05rem) 55%,
      calc(100% - 0.72rem) 55%;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
  }
  .contact-form input:focus-visible,
  .contact-form select:focus-visible,
  .contact-form textarea:focus-visible,
  .contact-form button:focus-visible {
    outline: 1px solid #c4a07a;
    outline-offset: 3px;
  }
  :global(.contact-thanks h2) {
    margin: 0;
    max-width: 12em;
    scroll-margin-top: 5.75rem;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  :global(.contact-thanks h2:focus) {
    outline: 1px solid #c4a07a;
    outline-offset: 8px;
  }
  .contact-thanks p {
    margin-top: 1.25rem;
    font-size: 1.125rem;
  }
  .contact-reach {
    margin-top: 2vh;
  }
  .contact-yt {
    margin: 2.2rem 0 0.35rem;
    font-family: var(--font-cinzel);
    font-weight: 400;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }
  .contact-reach a {
    color: #866243;
    text-decoration: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .contact-form button {
      transition: opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .contact-form button:hover {
      background: transparent;
      color: #f4f3ef;
      opacity: 0.55;
    }
  }
  @media (max-width: 800px) {
    .contact-page .enquire {
      padding: 4vh 1.5rem 6vh;
    }
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-form button {
      transition: none;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion, onPageLoad } from '../scripts/motion';
  import { showSentMark } from '../scripts/forms';
  import { heldLine, honeypotFilled, readField, scrollClearOfHeader, submitNote } from '../scripts/submit-note';
  import { formEndpoint } from '../data/site';

  onPageLoad(() => {
  const form = document.getElementById('contact-form');
  const topic = document.getElementById('contact-topic');

  if (topic instanceof HTMLSelectElement) {
    const requested = new URLSearchParams(location.search).get('topic');
    if (requested && [...topic.options].some((option) => option.value === requested)) {
      topic.value = requested;
    }
  }

  const showCard = (id: string) => {
    if (!(form instanceof HTMLFormElement)) return;
    const card = document.getElementById(id);
    if (!(card instanceof HTMLElement)) return;
    for (const otherId of ['contact-thanks', 'contact-draft']) {
      if (otherId === id) continue;
      const other = document.getElementById(otherId);
      if (other instanceof HTMLElement) other.hidden = true;
    }
    form.hidden = true;
    card.hidden = false;
    const host = card.querySelector('[data-sent-host]');
    if (host instanceof HTMLElement) showSentMark(host);
    const title = card.querySelector('h2');
    if (title instanceof HTMLElement) {
      title.focus({ preventScroll: true });
      scrollClearOfHeader(title);
    }
    if (!prefersReducedMotion()) {
      gsap.fromTo(card, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 1.6, ease: 'power3.out' });
    }
  };

  if (form instanceof HTMLFormElement && form.dataset.submitBound !== 'yes') {
    form.dataset.submitBound = 'yes';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector('[data-contact-status]');
      const statusLine = status?.querySelector('[data-status-line]');
      const button = form.querySelector('button[type="submit"]');
      if (!(status instanceof HTMLElement) || !(statusLine instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
      if (honeypotFilled(form)) return;
      button.disabled = true;
      if (formEndpoint.trim().startsWith('https://')) statusLine.textContent = 'Sending.';
      const result = await submitNote({
        form,
        subject: 'Aura note',
        fields: [
          ['Name', readField(form, 'name')],
          ['Email', readField(form, 'email')],
          ['Topic', readField(form, 'topic')],
          ['Message', readField(form, 'message')],
        ],
      });
      if (result.ok && result.via === 'https') {
        showCard('contact-thanks');
        return;
      }
      if (result.ok && result.via === 'mailto') {
        showCard('contact-draft');
        return;
      }
      if (result.via === 'honeypot') {
        button.disabled = false;
        return;
      }
      statusLine.textContent = result.via === 'held'
        ? heldLine
        : 'The line did not answer. Try again in a moment.';
      button.disabled = false;
      scrollClearOfHeader(status);
    });
  }

  const page = document.querySelector('.contact-page');
  if (page && !prefersReducedMotion()) {
    const card = page.querySelector('.contact-form');
    if (card instanceof HTMLElement) {
      gsap.from(card, {
        y: 22,
        opacity: 0,
        duration: 1.75,
        ease: 'power3.out',
      });
    }
  }
  });
</script>
