---
import RevealHeading from '../components/RevealHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Paste a Formspree URL here, or a mailto: address. TODO until the inbox exists.
const formAction = 'TODO';

const topics = [
  ['quote', 'Quote'],
  ['custom-build', 'Custom build'],
  ['hosting', 'Hosting'],
  ['partnership', 'Partnership'],
  ['press', 'Press'],
  ['other', 'Other'],
] as const;
---

<BaseLayout
  title="Contact | Aura Homes"
  description="Questions, ideas, hosting, partnerships. We read everything."
  descriptor="Contact"
>
  <main id="top" class="contact-page">
    <section class="page-lead">
      <p class="story-kicker">Contact</p>
      <RevealHeading as="h1">Write to us.</RevealHeading>
      <p class="story-lede">Questions, ideas, hosting, partnerships. We read everything.</p>
    </section>

    <section class="enquire" id="write">
      <form class="join-card contact-form" id="contact-form" action={formAction} method="post">
        <input class="join-hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="contact-grid">
          <div>
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="80" />
          </div>
          <div>
            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="120" />
          </div>
          <div class="is-wide">
            <label for="contact-topic">Topic</label>
            <select id="contact-topic" name="topic" required>
              <option value="" selected disabled>Choose one</option>
              {topics.map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          </div>
          <div class="is-wide">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" required maxlength="2000"></textarea>
          </div>
        </div>
        <button type="submit">Send the note</button>
        <p class="join-status" data-contact-status role="status"></p>
      </form>

      <div class="join-card contact-thanks" id="contact-thanks" hidden>
        <RevealHeading as="h2" tabindex="-1">We have your note.</RevealHeading>
        <p data-contact-thanks-line>We read everything.</p>
      </div>
    </section>

    <div class="page-body contact-reach">
      <p class="todo-line">Email: TODO</p>
      <p class="todo-line">Phone: TODO</p>
      <p>Edmonton, Alberta. Shipping across Canada.</p>
      <p class="contact-yt">Follow the build on YouTube</p>
      <p class="todo-line">Link: TODO</p>
      <p>
        If you only want your name held, use <a href="/pre-order">Pre-order</a>. That form takes no payment.
        Shorter answers are on the <a href="/faq">FAQ</a>.
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .contact-page .enquire {
    min-height: 0;
    justify-content: flex-start;
    padding: 6vh 8vw 8vh;
  }
  .contact-form,
  .contact-thanks {
    width: min(100%, 46rem);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 1.25rem;
  }
  .contact-grid .is-wide {
    grid-column: 1 / -1;
  }
  .contact-form select {
    padding-right: 2rem;
    background-image:
      linear-gradient(45deg, transparent 50%, #c4a07a 50%),
      linear-gradient(135deg, #c4a07a 50%, transparent 50%);
    background-position:
      calc(100% - 1.05rem) 55%,
      calc(100% - 0.72rem) 55%;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
  }
  .contact-form input:focus-visible,
  .contact-form select:focus-visible,
  .contact-form textarea:focus-visible,
  .contact-form button:focus-visible {
    outline: 1px solid #c4a07a;
    outline-offset: 3px;
  }
  :global(.contact-thanks h2) {
    margin: 0;
    max-width: 12em;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  :global(.contact-thanks h2:focus) {
    outline: 1px solid #c4a07a;
    outline-offset: 8px;
  }
  .contact-thanks p {
    margin-top: 1.25rem;
    font-size: 1.125rem;
  }
  .contact-reach {
    margin-top: 2vh;
  }
  .contact-yt {
    margin: 2.2rem 0 0.35rem;
    font-family: var(--font-cinzel);
    font-weight: 400;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }
  .contact-reach a {
    color: #866243;
    text-decoration: none;
    border-bottom: 1px solid rgba(156, 122, 85, 0.55);
    padding-bottom: 0.08rem;
    transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .contact-reach a:hover {
    opacity: 0.55;
  }
  @media (prefers-reduced-motion: no-preference) {
    .contact-form button {
      transition: opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .contact-form button:hover {
      background: transparent;
      color: #f4f3ef;
      opacity: 0.55;
    }
  }
  @media (max-width: 800px) {
    .contact-page .enquire {
      padding: 4vh 1.5rem 6vh;
    }
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-form button,
    .contact-reach a {
      transition: none;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion, onPageLoad } from '../scripts/motion';

  onPageLoad(() => {
  const form = document.getElementById('contact-form');
  const thanks = document.getElementById('contact-thanks');
  const topic = document.getElementById('contact-topic');

  if (topic instanceof HTMLSelectElement) {
    const requested = new URLSearchParams(location.search).get('topic');
    if (requested && [...topic.options].some((option) => option.value === requested)) {
      topic.value = requested;
    }
  }

  const fieldText = (name: string) => {
    if (!(form instanceof HTMLFormElement)) return '';
    const el = form.elements.namedItem(name);
    if (el instanceof HTMLSelectElement) return el.selectedOptions[0]?.textContent?.trim() || '';
    if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) return el.value.trim();
    return '';
  };

  const showThanks = (sent: boolean) => {
    if (!(form instanceof HTMLFormElement) || !(thanks instanceof HTMLElement)) return;
    const line = thanks.querySelector('[data-contact-thanks-line]');
    if (line) {
      line.textContent = sent
        ? 'We read everything.'
        : 'The inbox is not open yet, so this note stayed here.';
    }
    form.hidden = true;
    thanks.hidden = false;
    const title = thanks.querySelector('h2');
    if (title instanceof HTMLElement) title.focus();
    if (!prefersReducedMotion()) {
      gsap.fromTo(thanks, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 1.6, ease: 'power3.out' });
    }
    window.__lenis?.scrollTo(thanks, { immediate: true });
  };

  if (form instanceof HTMLFormElement && thanks instanceof HTMLElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector('[data-contact-status]');
      const button = form.querySelector('button[type="submit"]');
      if (!(status instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
      if (fieldText('company') !== '') {
        showThanks(false);
        return;
      }
      button.disabled = true;
      const action = form.getAttribute('action') || '';
      try {
        if (action.startsWith('https://')) {
          status.textContent = 'Sending.';
          const res = await fetch(action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error('status');
          showThanks(true);
        } else if (action.startsWith('mailto:')) {
          const lines = [
            ['Name', fieldText('name')],
            ['Email', fieldText('email')],
            ['Topic', fieldText('topic')],
            ['Message', fieldText('message')],
          ].map(([label, value]) => `${label}: ${value || ''}`);
          const joiner = action.includes('?') ? '&' : '?';
          window.location.href = `${action}${joiner}subject=${encodeURIComponent('Aura Homes note')}&body=${encodeURIComponent(lines.join('\n'))}`;
          showThanks(true);
        } else {
          showThanks(false);
        }
      } catch {
        status.textContent = 'The line did not answer. Try again in a moment.';
        button.disabled = false;
      }
    });
  }

  const page = document.querySelector('.contact-page');
  if (page && !prefersReducedMotion()) {
    const card = page.querySelector('.contact-form');
    if (card instanceof HTMLElement) {
      gsap.from(card, {
        y: 22,
        opacity: 0,
        duration: 1.75,
        ease: 'power3.out',
      });
    }
  }
  });
</script>
