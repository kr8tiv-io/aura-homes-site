---
import BaseLayout from '../layouts/BaseLayout.astro';
import LivingHero from '../components/LivingHero.astro';
import Materials from '../components/Materials.astro';
import RevealHeading from '../components/RevealHeading.astro';
import ShotHold from '../components/ShotHold.astro';
import Still from '../components/Still.astro';
import WindowFrame from '../components/WindowFrame.astro';
import { roomConcepts } from '../lib/rooms';

const uses = [
  ['01', 'Home extension'],
  ['02', 'Backyard or acreage office'],
  ['03', 'Escape room'],
  ['04', 'Rental stay'],
];
---

<BaseLayout
  title="Rooms | Aura Homes"
  description="Beautiful second-life rooms that bring people back to nature, one room at a time."
  descriptor="Rooms"
>
  <main id="top" class="room-collection">
    <LivingHero
      labelledby="rooms-title"
      film="/film/hero/room.mp4"
      poster="/film/story-room.webp"
      alt="An open wood room at dusk, linen seating inside, a meadow and a dark treeline beyond the glass."
      width={1280}
      height={914}
      eager
    >
      <div data-rise>
        <p class="story-kicker">Rooms</p>
        <RevealHeading as="h1" id="rooms-title">The rooms.</RevealHeading>
        <p class="story-lede">A vibrant extension of your home, in synergy with nature.</p>
      </div>
    </LivingHero>

    <p class="room-note">Every unit is built one at a time. Concepts shown; details evolve as we build.</p>

    <ul class="room-uses" data-rise>
      {uses.map(([index, label]) => (
        <li>
          <span>{index}</span>
          <strong>{label}</strong>
        </li>
      ))}
    </ul>

    <ul class="room-grid" data-window-grid>
      {roomConcepts.map((room) => (
        <li>
          <article class="room-card" data-rise data-room-card data-cursor="drag">
            <div class="room-tilt" data-room-tilt>
              <div class="room-face">
                {room.image ? (
                  <figure data-window>
                    <WindowFrame>
                      <Still
                        src={room.image}
                        alt={room.alt}
                        position={room.focus}
                        sizes="(max-width: 800px) 92vw, 42vw"
                      />
                    </WindowFrame>
                  </figure>
                ) : (
                  <figure>
                    <ShotHold caption={room.shot ?? room.alt} />
                  </figure>
                )}
                <RevealHeading as="h2">{room.name}</RevealHeading>
                <p>{room.description}</p>
                <a class="is-slide" href={`/pre-order?model=${room.slug}`}><span class="slide-face"><span class="slide-line">Pre-order inquiry</span><span class="slide-line" aria-hidden="true">Pre-order inquiry</span></span></a>
                <span class="room-sheen" aria-hidden="true"><span></span></span>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <Materials />
  </main>
</BaseLayout>

<style>
  .room-note {
    position: relative;
    z-index: 1;
    max-width: 32rem;
    margin: 0;
    padding: 6vh 8vw 0;
    font-weight: 300;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(20, 18, 14, 0.62);
  }
  .room-uses {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: 0;
    padding: 3.5rem 8vw;
    list-style: none;
    border-top: 1px solid rgba(20, 18, 14, 0.14);
    border-bottom: 1px solid rgba(20, 18, 14, 0.14);
    color: #14120e;
  }
  .room-uses span {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    color: #866243;
  }
  .room-uses strong {
    display: block;
    font-family: var(--font-cinzel);
    font-weight: 400;
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .room-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3.5rem, 6vw, 5.5rem) clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 8vh 8vw 4vh;
    list-style: none;
  }
  .room-card {
    color: #14120e;
    perspective: 1100px;
  }
  .room-tilt {
    transform-origin: center center;
  }
  .room-face {
    position: relative;
  }
  .room-sheen {
    position: absolute;
    inset: 0;
    z-index: 3;
    overflow: hidden;
    pointer-events: none;
  }
  .room-sheen span {
    position: absolute;
    top: -40%;
    bottom: -40%;
    left: 0;
    width: 38%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(244, 243, 239, 0.04) 28%,
      rgba(255, 255, 255, 0.62) 47%,
      rgba(206, 220, 214, 0.22) 55%,
      rgba(255, 255, 255, 0.05) 68%,
      transparent 100%
    );
    transform: translate3d(-160%, 0, 0) skewX(-16deg);
    opacity: 0;
  }
  .room-card figure {
    margin: 0 0 1.35rem;
    overflow: hidden;
    background: #0c0d0e;
    aspect-ratio: 3 / 2;
  }
  .room-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.room-card h2) {
    margin: 0 0 0.55rem;
    font-family: var(--font-cinzel);
    font-weight: 400;
    font-size: clamp(1.7rem, 2.4vw, 2.15rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .room-card p {
    max-width: 22rem;
    margin: 0 0 1.35rem;
    font-weight: 300;
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(20, 18, 14, 0.74);
  }
  .room-card a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.7rem 1.05rem;
    border: 1px solid #14120e;
    color: #14120e;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }
  @keyframes room-sheen {
    0% {
      transform: translate3d(-160%, 0, 0) skewX(-16deg);
      opacity: 0;
    }
    18% {
      opacity: 0.72;
    }
    72% {
      opacity: 0.72;
    }
    100% {
      transform: translate3d(340%, 0, 0) skewX(-16deg);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .room-card:hover .room-sheen span,
    .room-card:focus-within .room-sheen span {
      animation: room-sheen 3.4s cubic-bezier(0.77, 0, 0.175, 1);
    }
    .room-card img {
      transition: transform 1.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .room-card:hover img,
    .room-card:focus-within img {
      transform: scale(1.035);
    }
    .room-card a {
      transition: opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .room-card a:hover {
      opacity: 0.55;
    }
  }
  @media (max-width: 800px) {
    .room-note {
      padding: 4vh 1.5rem 0;
    }
    .room-uses {
      display: flex;
      gap: 2.2rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 2.2rem 1.5rem;
    }
    .room-uses li {
      flex: 0 0 68%;
      scroll-snap-align: start;
    }
    .room-grid {
      grid-template-columns: 1fr;
      padding: 6vh 1.5rem 2vh;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .room-uses {
      scroll-snap-type: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion, onPageLoad, holdPageMotion } from '../scripts/motion';

  const TILT = 4;

  /** A slow lean toward the pointer. Four degrees at the edge, then it settles home. */
  function bindCardTilt(page: ParentNode) {
    if (prefersReducedMotion()) return;
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    const stops: Array<() => void> = [];
    page.querySelectorAll<HTMLElement>('[data-room-card]').forEach((card) => {
      if (card.dataset.tiltBound) return;
      const tilt = card.querySelector<HTMLElement>('[data-room-tilt]');
      if (!tilt) return;
      card.dataset.tiltBound = 'yes';
      const rx = gsap.quickTo(tilt, 'rotationX', { duration: 1.05, ease: 'power3.out' });
      const ry = gsap.quickTo(tilt, 'rotationY', { duration: 1.05, ease: 'power3.out' });
      const onMove = (event: PointerEvent) => {
        const box = card.getBoundingClientRect();
        if (!box.width || !box.height) return;
        const px = Math.max(-0.5, Math.min(0.5, (event.clientX - box.left) / box.width - 0.5));
        const py = Math.max(-0.5, Math.min(0.5, (event.clientY - box.top) / box.height - 0.5));
        ry(px * -(TILT * 2));
        rx(py * (TILT * 2));
      };
      const onLeave = () => {
        rx(0);
        ry(0);
      };
      card.addEventListener('pointermove', onMove);
      card.addEventListener('pointerleave', onLeave);
      stops.push(() => {
        card.removeEventListener('pointermove', onMove);
        card.removeEventListener('pointerleave', onLeave);
        delete card.dataset.tiltBound;
        rx(0);
        ry(0);
      });
    });
    if (stops.length) holdPageMotion(() => stops.forEach((stop) => stop()));
  }

  onPageLoad(() => {

  const page = document.querySelector('.room-collection');
  if (!page) return;
  bindCardTilt(page);
  if (!prefersReducedMotion()) {
    ScrollTrigger.getAll()
      .filter((trigger) => trigger.vars.id === 'room-rise')
      .forEach((trigger) => trigger.kill());

    gsap.utils.toArray<HTMLElement>('[data-rise]', page).forEach((el) => {
      gsap.from(el, {
        y: 24,
        opacity: 0,
        duration: 1.7,
        ease: 'power3.out',
        scrollTrigger: {
          id: 'room-rise',
          trigger: el,
          start: 'top 90%',
          once: true,
        },
      });
    });

    const settle = () => ScrollTrigger.refresh();
    requestAnimationFrame(settle);
    window.addEventListener('load', settle, { once: true });
  }
  });
</script>
