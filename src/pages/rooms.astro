---
import BaseLayout from '../layouts/BaseLayout.astro';
import Materials from '../components/Materials.astro';
import RevealHeading from '../components/RevealHeading.astro';
import ShotHold from '../components/ShotHold.astro';
import Still from '../components/Still.astro';
import { roomConcepts } from '../lib/rooms';

const uses = [
  ['01', 'Home extension'],
  ['02', 'Backyard or acreage office'],
  ['03', 'Escape room'],
  ['04', 'Rental stay'],
];
---

<BaseLayout
  title="Rooms | Aura Homes"
  description="Beautiful second-life rooms that bring people back to nature, one room at a time."
  descriptor="Rooms"
>
  <main id="top" class="room-collection">
    <section class="page-lead">
      <p class="story-kicker">Rooms</p>
      <RevealHeading as="h1">The rooms.</RevealHeading>
      <p class="story-lede">A vibrant extension of your home, in synergy with nature.</p>
      <p class="room-note">Every unit is built one at a time. Concepts shown; details evolve as we build.</p>
    </section>

    <ul class="room-uses" data-rise>
      {uses.map(([index, label]) => (
        <li>
          <span>{index}</span>
          <strong>{label}</strong>
        </li>
      ))}
    </ul>

    <ul class="room-grid">
      {roomConcepts.map((room) => (
        <li>
          <article class="room-card" data-rise>
            <figure>
              {room.image ? (
                <Still
                  src={room.image}
                  alt={room.alt}
                  position={room.focus}
                  sizes="(max-width: 800px) 92vw, 42vw"
                />
              ) : (
                <ShotHold caption={room.shot ?? room.alt} />
              )}
            </figure>
            <RevealHeading as="h2">{room.name}</RevealHeading>
            <p>{room.description}</p>
            <a href={`/pre-order?model=${room.slug}`}>Pre-order inquiry</a>
          </article>
        </li>
      ))}
    </ul>

    <Materials />
  </main>
</BaseLayout>

<style>
  .room-note {
    max-width: 32rem;
    margin: 1.6rem 0 0;
    font-weight: 300;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(20, 18, 14, 0.62);
  }
  .room-uses {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: 0;
    padding: 3.5rem 8vw;
    list-style: none;
    border-top: 1px solid rgba(20, 18, 14, 0.14);
    border-bottom: 1px solid rgba(20, 18, 14, 0.14);
    color: #14120e;
  }
  .room-uses span {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    color: #866243;
  }
  .room-uses strong {
    display: block;
    font-family: var(--font-cinzel);
    font-weight: 400;
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .room-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3.5rem, 6vw, 5.5rem) clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 8vh 8vw 4vh;
    list-style: none;
  }
  .room-card {
    color: #14120e;
  }
  .room-card figure {
    margin: 0 0 1.35rem;
    overflow: hidden;
    background: #0c0d0e;
    aspect-ratio: 3 / 2;
  }
  .room-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.room-card h2) {
    margin: 0 0 0.55rem;
    font-family: var(--font-cinzel);
    font-weight: 400;
    font-size: clamp(1.7rem, 2.4vw, 2.15rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .room-card p {
    max-width: 22rem;
    margin: 0 0 1.35rem;
    font-weight: 300;
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(20, 18, 14, 0.74);
  }
  .room-card a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.7rem 1.05rem;
    border: 1px solid #14120e;
    color: #14120e;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .room-card img {
      transition: transform 1.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .room-card:hover img,
    .room-card:focus-within img {
      transform: scale(1.035);
    }
    .room-card a {
      transition: opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .room-card a:hover {
      opacity: 0.55;
    }
  }
  @media (max-width: 800px) {
    .room-uses {
      display: flex;
      gap: 2.2rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 2.2rem 1.5rem;
    }
    .room-uses li {
      flex: 0 0 68%;
      scroll-snap-align: start;
    }
    .room-grid {
      grid-template-columns: 1fr;
      padding: 6vh 1.5rem 2vh;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .room-uses {
      scroll-snap-type: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion, onPageLoad } from '../scripts/motion';

  onPageLoad(() => {

  const page = document.querySelector('.room-collection');
  if (page && !prefersReducedMotion()) {
    ScrollTrigger.getAll()
      .filter((trigger) => trigger.vars.id === 'room-rise')
      .forEach((trigger) => trigger.kill());

    gsap.utils.toArray<HTMLElement>('[data-rise]', page).forEach((el) => {
      gsap.from(el, {
        y: 24,
        opacity: 0,
        duration: 1.7,
        ease: 'power3.out',
        scrollTrigger: {
          id: 'room-rise',
          trigger: el,
          start: 'top 90%',
          once: true,
        },
      });
    });

    const settle = () => ScrollTrigger.refresh();
    requestAnimationFrame(settle);
    window.addEventListener('load', settle, { once: true });
  }
  });
</script>
