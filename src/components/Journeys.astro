---
interface Props {
  reveal?: boolean;
}

const { reveal = false } = Astro.props;
---

<section class="journeys is-folio" id="journeys">
  <p class="story-kicker" data-tracer="rule">The story</p>
  {
    reveal ? (
      <h2 data-glow data-reveal-heading aria-label="One room. A lot of side hustles.">
        One room. <br />A lot of side hustles.
      </h2>
    ) : (
      <h2 data-glow aria-label="One room. A lot of side hustles.">
        <span class="line-mask"><span class="line">One room.</span></span>
        {' '}
        <span class="line-mask"><span class="line">A lot of side hustles.</span></span>
      </h2>
    )
  }
  <ol>
    <li>
      <a href="/#shell" data-tracer="edge">
        <figure class="journey-still" aria-hidden="true"><img src="/film/story-meadow-side.webp" alt="" width="1280" height="922" decoding="async" /></figure>
        <span>01</span>
        <strong>The room</strong>
        <p>A guest room, an office or a getaway, on land you already have.</p>
      </a>
    </li>
    <li>
      <a href="/glass" data-tracer="edge">
        <figure class="journey-still" aria-hidden="true"><img src="/film/layout-sky.webp" alt="" width="1600" height="1200" decoding="async" /></figure>
        <span>02</span>
        <strong>The glass</strong>
        <p>Glass decks on screw piles, lit from underneath, with balconies.</p>
      </a>
    </li>
    <li>
      <a href="/resorts" data-tracer="edge">
        <figure class="journey-still" aria-hidden="true"><img src="/film/resort-tower.webp" alt="" width="1600" height="1200" decoding="async" style="object-position:center 18%" /></figure>
        <span>03</span>
        <strong>The resorts</strong>
        <p>Small custom eco resorts, in Canada and Costa Rica.</p>
      </a>
    </li>
    <li>
      <a href="/farms" data-tracer="edge">
        <figure class="journey-still" aria-hidden="true"><img src="/film/farm-wall.webp" alt="" width="1600" height="1200" decoding="async" /></figure>
        <span>04</span>
        <strong>Aura Farms</strong>
        <p>A room with a wall that grows food. Grow it yourself, or have Aura set it up.</p>
      </a>
    </li>
    <li>
      <a href="/water" data-tracer="edge">
        <figure class="journey-still" aria-hidden="true"><img src="/film/water-line.webp" alt="" width="1600" height="1200" decoding="async" /></figure>
        <span>05</span>
        <strong>Thirst Contact</strong>
        <p>Water from the sky, bottled in the backyard. A standard atmospheric water generator, built into the room.</p>
      </a>
    </li>
  </ol>
</section>
