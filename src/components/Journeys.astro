---
interface Props {
  reveal?: boolean;
}

const { reveal = false } = Astro.props;
---

<section class="journeys" id="journeys">
  <p class="story-kicker" data-tracer="rule">The story</p>
  {
    reveal ? (
      <h2 data-glow data-reveal-heading aria-label="One room. Several lives.">
        One room. <br />Several lives.
      </h2>
    ) : (
      <h2 data-glow aria-label="One room. Several lives.">
        <span class="line-mask"><span class="line">One room.</span></span>
        {' '}
        <span class="line-mask"><span class="line">Several lives.</span></span>
      </h2>
    )
  }
  <ol>
    <li>
      <a href="/#shell" data-tracer="edge">
        <span>01</span>
        <strong>The room</strong>
        <p>An extension, or a stay, on the land you already have.</p>
      </a>
    </li>
    <li>
      <a href="/glass" data-tracer="edge">
        <span>02</span>
        <strong>The glass</strong>
        <p>Helical piles, a lit floor, a deck, and balconies.</p>
      </a>
    </li>
    <li>
      <a href="/resorts" data-tracer="edge">
        <span>03</span>
        <strong>The resorts</strong>
        <p>A few rooms, custom, in Canada and Costa Rica.</p>
      </a>
    </li>
    <li>
      <a href="/farms" data-tracer="edge">
        <span>04</span>
        <strong>Aura Farms</strong>
        <p>A vertical aeroponic wall. Buy it and grow, or ask Aura to place it.</p>
      </a>
    </li>
    <li>
      <a href="/water" data-tracer="edge">
        <span>05</span>
        <strong>Thirst Contact</strong>
        <p>Comes later. The water unit still needs further research.</p>
      </a>
    </li>
  </ol>
</section>
