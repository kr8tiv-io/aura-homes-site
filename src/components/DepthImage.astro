---
import Still from './Still.astro';

interface Props {
  src: string;
  alt: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /**
   * Back to nature only. Sky, the unit, and a near grass edge,
   * each sliding at its own speed.
   */
  field?: boolean;
}

const { src, alt, loading = 'lazy', fetchpriority, field = false } = Astro.props;
---

<div class="depth-image" data-depth-root data-depth-field={field ? 'yes' : undefined}>
  <div class="depth-layer depth-mid" data-depth-speed="0.8">
    <div class="depth-mover">
      <Still src={src} alt={alt} loading={loading} fetchpriority={fetchpriority} />
    </div>
  </div>
  {
    field && (
      <div class="depth-layer depth-sky" data-depth-speed="0.9" aria-hidden="true">
        <div class="depth-mover">
          <Still src={src} alt="" loading="lazy" />
        </div>
      </div>
    )
  }
  {
    field && (
      <div class="depth-layer depth-fore" data-depth-speed="0.65" aria-hidden="true">
        <div class="depth-mover">
          <Still src={src} alt="" loading="lazy" />
        </div>
      </div>
    )
  }
</div>

<style is:global>
  .depth-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .depth-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .depth-mover {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform-origin: center center;
  }
  .depth-image .depth-mover picture.still-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .depth-image .depth-mover img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .depth-image[data-depth-field] .depth-sky {
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 8%, transparent 26%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 8%, transparent 26%);
  }
  .depth-image[data-depth-field] .depth-sky img {
    filter: blur(2px);
  }
  .depth-image[data-depth-field] .depth-fore {
    -webkit-mask-image: linear-gradient(to top, #000 0%, #000 6%, transparent 20%);
    mask-image: linear-gradient(to top, #000 0%, #000 6%, transparent 20%);
  }
  .depth-image[data-depth-field] .depth-fore img {
    filter: blur(5px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .depth-mover {
      will-change: transform;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .depth-sky,
    .depth-fore {
      display: none;
    }
    .depth-mover {
      top: 0;
      height: 100%;
      transform: none;
    }
  }
</style>

<script>
  import { onPageLoad } from '../scripts/motion';
  import { bindDepthImages } from '../scripts/depth';

  onPageLoad(() => bindDepthImages());
</script>
