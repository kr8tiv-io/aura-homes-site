---
interface Props {
  shell?: 'room' | 'glass' | 'resort' | 'farm' | 'water' | 'unsure';
}

const { shell = 'room' } = Astro.props;
const shells = [
  ['room', 'A room, on your land'],
  ['glass', 'Glass, on helical piles'],
  ['resort', 'A small resort'],
  ['farm', 'Aura Farms, the wall'],
  ['water', 'Water from the air'],
  ['unsure', 'Not sure yet'],
] as const;
---

<div class="join">
  <form class="join-card join-form" id="preorder" action="/api/join" method="post">
    <p class="story-kicker">Pre-order</p>
    <h3>Hold your place.</h3>
    <p class="join-model" data-model-line hidden></p>
    <p data-join-intro>Tell us which room you want. You are among the first we write when that build opens. This page takes no payment. It holds your name.</p>
    <input class="join-hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <input type="hidden" name="kind" value="preorder" />
    <div class="field">
      <input id="preorder-name" name="name" type="text" autocomplete="name" required maxlength="80" placeholder=" " />
      <label for="preorder-name">Name</label>
      <span class="field-glow" aria-hidden="true"></span>
    </div>
    <div class="field">
      <input id="preorder-email" name="email" type="email" autocomplete="email" required maxlength="120" placeholder=" " />
      <label for="preorder-email">Email</label>
      <span class="field-glow" aria-hidden="true"></span>
    </div>
    <div class="field">
      <select id="preorder-shell" name="shell" required>
        {shells.map(([value, label]) => (
          <option value={value} selected={value === shell}>{label}</option>
        ))}
      </select>
      <label for="preorder-shell">Room</label>
      <span class="field-glow" aria-hidden="true"></span>
    </div>
    <div class="field">
      <textarea id="preorder-note" name="note" maxlength="500" placeholder=" "></textarea>
      <label for="preorder-note">The land, or the question</label>
      <span class="field-glow" aria-hidden="true"></span>
    </div>
    <label class="join-check">
      <input type="checkbox" name="list" value="yes" />
      <span>Also put me first in line for the latest YouTube films, product releases, announcements, and the offers and perks kept for this list.</span>
    </label>
    <button type="submit" class="is-slide"><span class="slide-face"><span class="slide-line">Hold my place</span><span class="slide-line" aria-hidden="true">Hold my place</span></span></button>
    <p class="join-status" data-join-status data-sent-host role="status"><span data-status-line></span></p>
    <p class="join-fine">Aura Homes writes to the address you give. You can leave the list whenever a note arrives. We do not sell it.</p>
  </form>

  <form class="join-card join-form" id="list" action="/api/join" method="post">
    <p class="story-kicker">The list</p>
    <h3>First to hear it.</h3>
    <p>Join, and you are first in line for the latest YouTube films, product releases, announcements, and the offers and perks we keep for the people who were here early.</p>
    <input class="join-hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <input type="hidden" name="kind" value="list" />
    <div class="field">
      <input id="list-name" name="name" type="text" autocomplete="name" required maxlength="80" placeholder=" " />
      <label for="list-name">Name</label>
      <span class="field-glow" aria-hidden="true"></span>
    </div>
    <div class="field">
      <input id="list-email" name="email" type="email" autocomplete="email" required maxlength="120" placeholder=" " />
      <label for="list-email">Email</label>
      <span class="field-glow" aria-hidden="true"></span>
    </div>
    <label class="join-check">
      <input type="checkbox" name="consent" value="yes" required />
      <span>Yes. Send me the films, the releases, the announcements, and the exclusive offers and perks.</span>
    </label>
    <button type="submit" class="is-slide"><span class="slide-face"><span class="slide-line">Count me in</span><span class="slide-line" aria-hidden="true">Count me in</span></span></button>
    <p class="join-status" data-join-status data-sent-host role="status"><span data-status-line></span></p>
    <p class="join-fine">Your name is held. The first notes are the films, the releases, the announcements, and the offers kept for this list.</p>
  </form>
</div>

<script>
  import { roomBySlug } from '../lib/rooms';
  import { onPageLoad } from '../scripts/motion';
  import { clearSentMark, showSentMark } from '../scripts/forms';

  onPageLoad(() => {
  const params = new URLSearchParams(location.search);
  const concept = roomBySlug(params.get('model'));
  if (concept) {
    const select = document.getElementById('preorder-shell');
    if (select instanceof HTMLSelectElement) select.value = concept.shell;
    const note = document.getElementById('preorder-note');
    if (note instanceof HTMLTextAreaElement && note.value.trim() === '') {
      note.value = `Concept: ${concept.name}.`;
    }
    const line = document.querySelector('[data-model-line]');
    if (line instanceof HTMLElement) {
      line.textContent = `Asking about ${concept.name}.`;
      line.hidden = false;
    }
    const lede = document.querySelector('[data-preorder-lede]');
    if (lede) {
      lede.textContent = `You asked about ${concept.name}. Tell us the land, and we will write when that build opens. This page takes no payment. It holds your name.`;
    }
  } else if (params.get('type') === 'custom') {
    const note = document.getElementById('preorder-note');
    if (note instanceof HTMLTextAreaElement && note.value.trim() === '') {
      note.value = 'Custom: Second Breath.';
    }
    const line = document.querySelector('[data-model-line]');
    if (line instanceof HTMLElement) {
      line.textContent = 'Asking about a custom build.';
      line.hidden = false;
    }
    const lede = document.querySelector('[data-preorder-lede]');
    if (lede) {
      lede.textContent = 'You asked about a custom build. Tell us the idea, and we will write with a quote. This page takes no payment. It holds your name.';
    }
    const intro = document.querySelector('[data-join-intro]');
    if (intro) {
      intro.textContent = 'Tell us the idea. This page takes no payment. It holds your name.';
    }
  }

  const joined = params.get('joined');
  if (joined === 'list' || joined === 'preorder') {
    const form = document.getElementById(joined);
    const status = form?.querySelector('[data-join-status]');
    const line = status?.querySelector('[data-status-line]');
    if (status instanceof HTMLElement && line) {
      line.textContent = joined === 'preorder'
        ? 'Your place is held. No payment was taken.'
        : 'You are first in line for the films, the releases, and the offers.';
      showSentMark(status);
    }
  }

  document.querySelectorAll('form.join-form').forEach((form) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.joinBound === 'yes') return;
    form.dataset.joinBound = 'yes';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector('[data-join-status]');
      const line = status?.querySelector('[data-status-line]');
      const button = form.querySelector('button[type="submit"]');
      if (!(status instanceof HTMLElement) || !(line instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
      button.disabled = true;
      clearSentMark(status);
      line.textContent = 'Sending.';
      try {
        const res = await fetch('/api/join', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = await res.json();
        line.textContent = data.message || 'Try again in a moment.';
        if (res.ok) {
          form.reset();
          showSentMark(status);
        }
      } catch {
        line.textContent = 'The line did not answer. Try again in a moment.';
      } finally {
        button.disabled = false;
      }
    });
  });
  });
</script>
