---
import { Picture } from 'astro:assets';
import { still } from '../lib/stills';

interface Props {
  src: string;
  alt: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  position?: string;
  /** Phone-only object-position. Desktop keeps `position`. */
  phonePosition?: string;
  rise?: boolean;
  natural?: boolean;
}

const {
  src,
  alt,
  loading = 'lazy',
  fetchpriority,
  sizes = '100vw',
  position,
  phonePosition,
  rise = false,
  natural = false,
} = Astro.props;

const image = still(src);
const ladder = [480, 640, 960, 1280, 1920, 2560].filter((width) => width <= image.width);
const widths = ladder.length ? ladder : [image.width];
const imgStyle = [
  position ? `--still-pos:${position}` : '',
  phonePosition ? `--still-pos-phone:${phonePosition}` : '',
]
  .filter(Boolean)
  .join(';');
const pictureAttributes: Record<string, string> = {
  class: natural ? 'still-frame is-natural' : 'still-frame',
};
if (rise) pictureAttributes['data-rise'] = '';
---

<Picture
  src={image}
  formats={['avif']}
  fallbackFormat="webp"
  alt={alt}
  widths={widths}
  sizes={sizes}
  quality={70}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  style={imgStyle || undefined}
  pictureAttributes={pictureAttributes}
/>

<style>
  :global(picture.still-frame) {
    display: block;
    width: 100%;
    height: 100%;
  }
  :global(picture.still-frame img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--still-pos, center);
  }
  :global(picture.still-frame.is-natural),
  :global(picture.still-frame.is-natural img) {
    height: auto;
  }
  :global(.wild-frame) :global(picture.still-frame),
  :global(.stay-frame) :global(picture.still-frame),
  :global(.byo-fallback) :global(picture.still-frame) {
    position: absolute;
    inset: 0;
  }
  :global(.story-bleed) :global(picture.still-frame) {
    height: 115%;
  }
  :global(.story-bleed) :global(picture.still-frame img) {
    height: 100%;
  }
  @media (max-width: 800px) {
    :global(picture.still-frame img) {
      object-position: var(--still-pos-phone, var(--still-pos, center));
    }
    :global(.story-bleed) :global(picture.still-frame),
    :global(.story-bleed) :global(picture.still-frame img) {
      height: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.story-bleed) :global(picture.still-frame) {
      height: 100%;
    }
  }
</style>
