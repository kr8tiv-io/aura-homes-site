---
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<div class="shot-hold" role="img" aria-label={caption}>
  <p class="shot-hold-kicker">Shot to come</p>
  <p class="shot-hold-caption">{caption}</p>
</div>

<style>
  .shot-hold {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
    padding: 1.35rem 1.3rem 1.2rem;
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(156, 122, 85, 0.18), transparent 52%),
      #0c0d0e;
    box-shadow: inset 0 0 0 1px rgba(196, 160, 122, 0.35);
  }
  .shot-hold-kicker {
    margin: 0 0 0.55rem;
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #c4a07a;
  }
  .shot-hold-caption {
    margin: 0;
    max-width: 24rem;
    font-family: var(--font-cinzel);
    font-weight: 400;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: #f4f3ef;
  }
</style>
