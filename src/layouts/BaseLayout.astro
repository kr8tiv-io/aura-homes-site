---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Font, getImage } from 'astro:assets';
import Ambient from '../components/Ambient.astro';
import RidgeLoad from '../components/RidgeLoad.astro';
import AuraMark from '../components/AuraMark.astro';
import cabinPoster from '../../public/film/cabin-poster-hi.webp';
import { organizationJson } from '../lib/organization';

interface Props {
  title: string;
  description?: string;
  descriptor?: string;
}

const tagline = 'Return to Aura.';
const taglineMore = 'One beautiful room at a time.';
const about = 'Return to Aura. One beautiful room at a time.';
const { title: rawTitle, description = about, descriptor = 'On your land' } = Astro.props;
const brandTitle = (raw: string) => {
  if (raw === 'Aura Homes' || raw.endsWith('| Aura Homes')) return raw;
  if (raw.startsWith('Aura Homes | ')) return `${raw.slice('Aura Homes | '.length)} | Aura Homes`;
  if (raw.startsWith('Aura Farms | ')) return `${raw.slice('Aura Farms | '.length)} | Aura Homes`;
  return `${raw} | Aura Homes`;
};
const title = brandTitle(rawTitle);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const origin = Astro.site ?? Astro.url.origin;
const pageUrl = new URL(path, origin).href;
const canonical = pageUrl;
const og = await getImage({ src: cabinPoster, width: 1200, format: 'webp', quality: 72 });
const ogImage = new URL(og.src, origin).href;
const organization = organizationJson(origin);
const ogAlt = 'An Aura room at dusk, set in a meadow.';
const isHome = path === '/';
const isBuilder = path.startsWith('/builder') || path.startsWith('/build-your-own');
const showFoot = !isHome && !isBuilder;
const here = (href: string) => (href === '/journal' ? path.startsWith('/journal') : path === href);
const bar = [
  { href: '/story', label: 'Story' },
  { href: '/rooms', label: 'Rooms' },
  { href: '/customs', label: 'Customs' },
  { href: '/journal', label: 'Journal' },
];
const menu = [
  {
    label: 'The room',
    links: [
      { href: '/story', label: 'Story' },
      { href: '/rooms', label: 'Rooms' },
      { href: '/customs', label: 'Customs' },
      { href: '/build-your-own', label: 'Build Your Own' },
    ],
  },
  {
    label: 'The land',
    links: [
      { href: '/master-plan', label: 'Master plan' },
      { href: '/back-to-nature', label: 'Back to nature' },
      { href: '/journal', label: 'Journal' },
    ],
  },
  {
    label: 'A note',
    links: [
      { href: '/pre-order', label: 'Pre-order' },
      { href: '/faq', label: 'FAQ' },
      { href: '/contact', label: 'Contact' },
    ],
  },
];
const innerMenu = [
  menu[0],
  {
    label: 'The land',
    links: [
      { href: '/master-plan', label: 'Master Plan' },
      { href: '/farms', label: 'Aura Farms' },
      { href: '/h2o', label: 'Aura H2O' },
      { href: '/back-to-nature', label: 'Back to nature' },
      { href: '/journal', label: 'Journal' },
    ],
  },
  menu[2],
];
const topLinks = [
  { href: '/rooms', label: 'Rooms' },
  { href: '/customs', label: 'Customs' },
  { href: '/master-plan', label: 'Master Plan' },
  { href: '/farms', label: 'Aura Farms' },
  { href: '/h2o', label: 'Aura H2O' },
  { href: '/story', label: 'Story' },
];
const foot = innerMenu.flatMap((group) => group.links);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    {!isHome && <ClientRouter />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <Font cssVariable="--font-cinzel" preload />
    <Font cssVariable="--font-inter" preload />
    {!isHome && (
      <script is:inline>
        try {
          if (localStorage.getItem('aura-ridge') === '1') document.documentElement.classList.add('ridge-seen');
        } catch (error) {
          /* a private window can still play the ridge once */
        }
      </script>
    )}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    <meta property="og:site_name" content="Aura Homes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
  </head>
  <body class:list={['bg-alabaster text-obsidian font-inter antialiased', { 'is-builder': isBuilder, 'nav-on-film': isHome || isBuilder || path.startsWith('/back-to-nature') }]}>
    {isHome ? (
      <>
        <canvas id="tracers-canvas" class="tracers-canvas" aria-hidden="true"></canvas>
        <canvas id="warmth-canvas" class="warmth-canvas" aria-hidden="true"></canvas>
        <div class="page-grain" aria-hidden="true"></div>
        <div class="scroll-rail" aria-hidden="true"><div class="scroll-rail-thumb"></div></div>
        <div class="site-cursor" aria-hidden="true"><span class="site-cursor-word"></span></div>
      </>
    ) : (
      <>
        <canvas id="tracers-canvas" class="tracers-canvas" aria-hidden="true" transition:name="tracers" transition:persist="tracers" transition:animate="none"></canvas>
        <canvas id="warmth-canvas" class="warmth-canvas" aria-hidden="true" transition:name="warmth" transition:persist="warmth" transition:animate="none"></canvas>
        <div class="page-grain film-grain" aria-hidden="true" transition:name="grain" transition:persist="grain" transition:animate="none">
          <div class="film-grain-pane"></div>
          <div class="film-grain-pane is-b"></div>
        </div>
        <div class="daylight" id="daylight" aria-hidden="true" transition:name="daylight" transition:persist="daylight" transition:animate="none">
          <div class="daylight-sun daylight-dawn"></div>
          <div class="daylight-sun daylight-gold"></div>
          <div class="daylight-sun daylight-dusk"></div>
        </div>
        <div class="scroll-rail" aria-hidden="true" transition:name="rail" transition:persist="rail" transition:animate="none"><div class="scroll-rail-thumb"></div></div>
        <div class="site-cursor" aria-hidden="true" transition:name="cursor-ring" transition:persist="cursor-ring" transition:animate="none"><span class="site-cursor-word"></span></div>
        <div class="horizon-wipe" transition:name="horizon" transition:animate="none" aria-hidden="true"></div>
      </>
    )}

    {isHome ? (
      <header class="site-nav">
        <a href="/" class="nav-brand">
          <AuraMark play />
          <span class="font-cinzel text-xl tracking-widest uppercase">Aura</span>
          <span class="nav-descriptor hidden lg:inline pl-4 border-l border-current/30">{descriptor}</span>
        </a>
        <nav class="nav-words" aria-label="Pages">
          {bar.map((item) => (
            <a href={item.href} aria-current={here(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="nav-tools">
          <button type="button" class="nav-menu" aria-expanded="false" aria-controls="story-menu" aria-haspopup="dialog" aria-label="Menu">
            <svg class="nav-sigil" viewBox="0 0 200 188" aria-hidden="true">
              <g class="sigil-mark">
                <ellipse class="sigil-ring" cx="100" cy="15" rx="19" ry="5.2" transform="rotate(-6 100 15)" fill="none" stroke="#c4a07a" stroke-width="2" />
                <g class="sigil-ridge">
                  <path d="M6.000,172.810 L41.915,140.885 L60.831,159.801 L100.000,54.046 L139.169,159.801 L158.085,140.885 L194.000,172.810 L194.000,167.190 L157.915,135.115 L140.831,152.199 L100.000,41.954 L59.169,152.199 L42.085,135.115 L6.000,167.190 Z" />
                  <path d="M6.000,167.790 L6.000,164.390 L6.900,164.390 Q6.900,166.390 13.000,160.968 L13.000,161.568 Z" />
                  <path d="M6.000,172.210 L6.000,175.610 L6.900,175.610 Q6.900,172.010 13.000,166.587 L13.000,165.987 Z" />
                  <path d="M194.000,167.790 L194.000,164.390 L193.100,164.390 Q193.100,166.390 187.000,160.968 L187.000,161.568 Z" />
                  <path d="M194.000,172.210 L194.000,175.610 L193.100,175.610 Q193.100,172.010 187.000,166.587 L187.000,165.987 Z" />
                </g>
              </g>
            </svg>
          </button>
          <a href="/pre-order" class="nav-cta is-slide"><span class="slide-face"><span class="slide-line">Pre-order</span><span class="slide-line" aria-hidden="true">Pre-order</span></span></a>
        </div>
      </header>
    ) : (
      <header class="site-nav topbar" data-topbar transition:name="site-nav" transition:persist="site-nav" transition:animate="none">
        <span class="topbar-frost" aria-hidden="true"></span>
        <a href="/" class="nav-brand">
          <AuraMark play />
          <span class="nav-name">Aura</span>
        </a>
        <nav class="nav-words" aria-label="Pages">
          {topLinks.map((item) => (
            <a href={item.href} aria-current={here(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="nav-tools">
          <a href="/pre-order" class="nav-quote" aria-current={path === '/pre-order' ? 'page' : undefined}>Get a quote</a>
          <button type="button" class="nav-menu" aria-expanded="false" aria-controls="story-menu" aria-haspopup="dialog" aria-label="Menu">
            <span class="menu-word">Menu</span>
            <span class="menu-icon" aria-hidden="true">
              <span class="menu-line"></span>
              <span class="menu-line is-short"></span>
            </span>
          </button>
        </div>
      </header>
    )}
    {isHome ? (
      <div id="story-menu" class="nav-panel" role="dialog" aria-modal="true" aria-label="Menu" hidden>
        <div class="menu-horizon" aria-hidden="true"></div>
        <div class="menu-stage" aria-hidden="true">
          <div class="menu-ridge-clip">
            <div class="menu-ridge-shift">
              <svg class="menu-ridge" viewBox="0 0 200 188" fill="none">
                <g class="aura-ridge">
                  <path d="M6.000,172.810 L41.915,140.885 L60.831,159.801 L100.000,54.046 L139.169,159.801 L158.085,140.885 L194.000,172.810 L194.000,167.190 L157.915,135.115 L140.831,152.199 L100.000,41.954 L59.169,152.199 L42.085,135.115 L6.000,167.190 Z" />
                  <path d="M6.000,167.790 L6.000,164.390 L6.900,164.390 Q6.900,166.390 13.000,160.968 L13.000,161.568 Z" />
                  <path d="M6.000,172.210 L6.000,175.610 L6.900,175.610 Q6.900,172.010 13.000,166.587 L13.000,165.987 Z" />
                  <path d="M194.000,167.790 L194.000,164.390 L193.100,164.390 Q193.100,166.390 187.000,160.968 L187.000,161.568 Z" />
                  <path d="M194.000,172.210 L194.000,175.610 L193.100,175.610 Q193.100,172.010 187.000,166.587 L187.000,165.987 Z" />
                </g>
              </svg>
            </div>
          </div>
          <svg class="menu-ring" viewBox="0 0 200 188" fill="none" aria-hidden="true">
            <ellipse class="aura-ring" cx="100" cy="15" rx="19" ry="5.2" transform="rotate(-6 100 15)" />
          </svg>
        </div>
        <div class="nav-copy">
          <p class="nav-thesis">{tagline} {taglineMore}</p>
          <div class="nav-groups">
            {menu.map((group) => (
              <div>
                <p>{group.label}</p>
                {group.links.map((item) => (
                  <a href={item.href} aria-current={here(item.href) ? 'page' : undefined}>{item.label}</a>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    ) : (
      <div id="story-menu" class="nav-panel is-horizon" role="dialog" aria-modal="true" aria-label="Menu" hidden transition:name="story-menu" transition:persist="story-menu" transition:animate="none">
        <div class="menu-horizon" aria-hidden="true"></div>
        <div class="menu-stage" aria-hidden="true">
          <div class="menu-ridge-clip">
            <div class="menu-ridge-shift">
              <svg class="menu-ridge" viewBox="0 0 200 188" fill="none" shape-rendering="geometricPrecision">
                <g class="aura-ridge">
                  <path d="M6.000,172.810 L41.915,140.885 L60.831,159.801 L100.000,54.046 L139.169,159.801 L158.085,140.885 L194.000,172.810 L194.000,167.190 L157.915,135.115 L140.831,152.199 L100.000,41.954 L59.169,152.199 L42.085,135.115 L6.000,167.190 Z" />
                  <path d="M6.000,167.790 L6.000,164.390 L6.900,164.390 Q6.900,166.390 13.000,160.968 L13.000,161.568 Z" />
                  <path d="M6.000,172.210 L6.000,175.610 L6.900,175.610 Q6.900,172.010 13.000,166.587 L13.000,165.987 Z" />
                  <path d="M194.000,167.790 L194.000,164.390 L193.100,164.390 Q193.100,166.390 187.000,160.968 L187.000,161.568 Z" />
                  <path d="M194.000,172.210 L194.000,175.610 L193.100,175.610 Q193.100,172.010 187.000,166.587 L187.000,165.987 Z" />
                </g>
              </svg>
            </div>
          </div>
          <svg class="menu-ring" viewBox="0 0 200 188" fill="none" aria-hidden="true">
            <ellipse class="aura-ring" cx="100" cy="15" rx="19" ry="5.2" transform="rotate(-6 100 15)" />
          </svg>
        </div>
        <div class="nav-copy">
          <p class="nav-thesis">{tagline} {taglineMore}</p>
          <div class="nav-groups">
            {innerMenu.map((group) => (
              <div>
                <p>{group.label}</p>
                {group.links.map((item) => (
                  <a href={item.href} aria-current={here(item.href) ? 'page' : undefined}>{item.label}</a>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    <Ambient persist={!isHome} />
    {!isHome && <RidgeLoad />}

    <div class="page-main relative z-10">
      <slot />
    </div>
    {showFoot && (
      <footer class="site-foot">
        <a href="/" class="foot-brand">
          <AuraMark play />
          <span class="foot-name">Aura</span>
        </a>
        <p class="foot-line">{tagline}</p>
        <p class="foot-quiet">{taglineMore}</p>
        <p class="foot-place">Edmonton, Alberta. Shipping across Canada.</p>
        <nav class="foot-nav" aria-label="Footer">
          {foot.map((item) => (
            <a href={item.href} aria-current={here(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <p class="foot-reach">Email: TODO</p>
        <p class="foot-reach">Phone: TODO</p>
        <a class="foot-credit" href="/credits" aria-current={path === '/credits' ? 'page' : undefined}>Credits</a>
      </footer>
    )}

    <script>
      import { gsap } from 'gsap';
      import { initSmoothScroll, resetPageMotion, stopSmoothScroll, ScrollTrigger } from '../scripts/motion';
      import { bindDaylight } from '../scripts/daylight';
      import { bindSiteCursor } from '../scripts/cursor';
      import { bindAmbient } from '../scripts/ambient';
      import { bindFields } from '../scripts/forms';
      import { bindRidgeLoad } from '../scripts/ridge-load';

      initSmoothScroll();
      bindDaylight();

      const copyCurrent = (live: ParentNode | null, incoming: ParentNode | null) => {
        if (!live || !incoming) return;
        const nextLinks = incoming.querySelectorAll<HTMLAnchorElement>('a[href]');
        live.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link, index) => {
          const source = nextLinks[index];
          if (!source || link.getAttribute('href') !== source.getAttribute('href')) return;
          const current = source.getAttribute('aria-current');
          if (current) link.setAttribute('aria-current', current);
          else link.removeAttribute('aria-current');
        });
      };

      document.addEventListener('astro:before-swap', ((event: Event) => {
        resetPageMotion();
        stopSmoothScroll();
        document.querySelectorAll('.site-nav .aura-logo').forEach((logo) => {
          logo.classList.remove('is-play');
        });
        const incoming = (event as Event & { newDocument?: Document }).newDocument;
        if (!incoming) return;
        copyCurrent(document.querySelector('.site-nav'), incoming.querySelector('.site-nav'));
        copyCurrent(document.getElementById('story-menu'), incoming.getElementById('story-menu'));
        const liveDesc = document.querySelector('.nav-descriptor');
        const nextDesc = incoming.querySelector('.nav-descriptor');
        if (liveDesc && nextDesc) liveDesc.textContent = nextDesc.textContent;
        const liveTools = document.querySelector('.nav-tools');
        const liveQuote = document.querySelector<HTMLAnchorElement>('.site-nav .nav-quote');
        const nextQuote = incoming.querySelector<HTMLAnchorElement>('.site-nav .nav-quote');
        if (liveQuote && nextQuote) {
          const current = nextQuote.getAttribute('aria-current');
          if (current) liveQuote.setAttribute('aria-current', current);
          else liveQuote.removeAttribute('aria-current');
        }
        const liveCta = document.querySelector<HTMLAnchorElement>('.site-nav .nav-cta');
        const nextCta = incoming.querySelector<HTMLAnchorElement>('.site-nav .nav-cta');
        if (liveCta && nextCta) {
          const current = nextCta.getAttribute('aria-current');
          if (current) liveCta.setAttribute('aria-current', current);
          else liveCta.removeAttribute('aria-current');
        } else if (liveCta && !nextCta) {
          liveCta.remove();
        } else if (!liveCta && nextCta && liveTools) {
          liveTools.append(nextCta.cloneNode(true));
        }
      }) as EventListener);

      document.addEventListener('astro:after-swap', () => {
        window.scrollTo(0, 0);
        window.__lenis?.scrollTo(0, { immediate: true, force: true });
        window.__lenis?.resize();
      });

      const canvas = document.getElementById('tracers-canvas') as HTMLCanvasElement | null;
      let tracerRaf = 0;
      const builderPage = document.body.classList.contains('is-builder');
      if (canvas && !builderPage) {
        const gl = canvas.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: false });
        if (gl) {
          const vert = `attribute vec2 a; void main(){ gl_Position = vec4(a, 0.0, 1.0); }`;
          const frag = `precision mediump float;
            uniform vec2 uRes;
            uniform float uTime;
            void main() {
              vec2 uv = gl_FragCoord.xy / uRes;
              vec3 col = vec3(0.0);
              float alpha = 0.0;
              for (int i = 0; i < 5; i++) {
                float fi = float(i);
                float speed = 0.018 + fi * 0.006;
                float slide = fract(uTime * speed + fi * 0.17);
                vec2 origin = vec2(slide * 1.6 - 0.3, 0.08 + fi * 0.16);
                vec2 dir = normalize(vec2(0.84, 0.18 + fi * 0.06));
                float d = abs(dot(uv - origin, vec2(-dir.y, dir.x)));
                float band = exp(-d * d * (520.0 - fi * 40.0));
                float head = smoothstep(0.0, 0.18, slide) * smoothstep(1.0, 0.72, slide);
                vec3 warm = vec3(0.77, 0.58, 0.38);
                vec3 cool = vec3(0.45, 0.62, 0.7);
                col += mix(warm, cool, fi / 4.0) * band * head;
                alpha += band * head * 0.22;
              }
              gl_FragColor = vec4(col, clamp(alpha, 0.0, 0.28));
            }`;
          const compile = (type: number, src: string) => {
            const shader = gl.createShader(type);
            if (!shader) return null;
            gl.shaderSource(shader, src);
            gl.compileShader(shader);
            return shader;
          };
          const program = gl.createProgram();
          const vs = compile(gl.VERTEX_SHADER, vert);
          const fs = compile(gl.FRAGMENT_SHADER, frag);
          if (program && vs && fs) {
            gl.attachShader(program, vs);
            gl.attachShader(program, fs);
            gl.linkProgram(program);
            gl.useProgram(program);
            const buffer = gl.createBuffer();
            gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
            gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
            const loc = gl.getAttribLocation(program, 'a');
            gl.enableVertexAttribArray(loc);
            gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
            const uRes = gl.getUniformLocation(program, 'uRes');
            const uTime = gl.getUniformLocation(program, 'uTime');
            gl.enable(gl.BLEND);
            gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
            const resize = () => {
              const dpr = Math.min(window.devicePixelRatio || 1, 1.25);
              canvas.width = Math.floor(window.innerWidth * dpr);
              canvas.height = Math.floor(window.innerHeight * dpr);
              gl.viewport(0, 0, canvas.width, canvas.height);
            };
            window.addEventListener('resize', resize, { passive: true });
            resize();
            const draw = (time: number) => {
              gl.uniform2f(uRes, canvas.width, canvas.height);
              gl.uniform1f(uTime, time * 0.001);
              gl.drawArrays(gl.TRIANGLES, 0, 3);
            };
            const reducedTracers = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reducedTracers) draw(0);
            else {
              const tick = (time: number) => {
                tracerRaf = requestAnimationFrame(tick);
                if (document.hidden) return;
                draw(time);
              };
              tracerRaf = requestAnimationFrame(tick);
            }
          }
        }
      }

      const warmth = document.getElementById('warmth-canvas') as HTMLCanvasElement | null;
      let warmthRaf = 0;
      if (warmth && !builderPage) {
        const gl = warmth.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: false });
        if (gl) {
          const vert = `attribute vec2 a; void main(){ gl_Position = vec4(a, 0.0, 1.0); }`;
          const frag = `precision mediump float;
            uniform vec2 uRes;
            uniform float uTime;
            uniform vec3 uL[8];
            void main() {
              float glow = 0.0;
              for (int i = 0; i < 8; i++) {
                float r = max(uL[i].z, 1.0);
                vec2 d = gl_FragCoord.xy - uL[i].xy;
                glow += exp(-dot(d, d) / (r * r)) * step(12.0, uL[i].z);
              }
              float warmth = 0.32 + 0.68 * (0.5 + 0.5 * sin(uTime * 0.22));
              vec3 ivory = vec3(0.98, 0.93, 0.84);
              vec3 amber = vec3(1.0, 0.74, 0.42);
              float alpha = clamp(glow, 0.0, 1.0) * (0.22 + warmth * 0.34);
              gl_FragColor = vec4(mix(ivory, amber, warmth), alpha);
            }`;
          const compile = (type: number, src: string) => {
            const shader = gl.createShader(type);
            if (!shader) return null;
            gl.shaderSource(shader, src);
            gl.compileShader(shader);
            return shader;
          };
          const program = gl.createProgram();
          const vs = compile(gl.VERTEX_SHADER, vert);
          const fs = compile(gl.FRAGMENT_SHADER, frag);
          if (program && vs && fs) {
            gl.attachShader(program, vs);
            gl.attachShader(program, fs);
            gl.linkProgram(program);
            gl.useProgram(program);
            const buffer = gl.createBuffer();
            gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
            gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
            const loc = gl.getAttribLocation(program, 'a');
            gl.enableVertexAttribArray(loc);
            gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
            const uRes = gl.getUniformLocation(program, 'uRes');
            const uTime = gl.getUniformLocation(program, 'uTime');
            const uL = gl.getUniformLocation(program, 'uL[0]');
            const lights = new Float32Array(24);
            gl.enable(gl.BLEND);
            gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
            const resizeWarmth = () => {
              const dpr = Math.min(window.devicePixelRatio || 1, 1.25);
              warmth.width = Math.floor(window.innerWidth * dpr);
              warmth.height = Math.floor(window.innerHeight * dpr);
              gl.viewport(0, 0, warmth.width, warmth.height);
            };
            const measureWarmth = () => {
              lights.fill(0);
              const dpr = Math.min(window.devicePixelRatio || 1, 1.25);
              const spots: Array<{ x: number; y: number; r: number }> = [];
              const nav = document.querySelector('.nav-words');
              if (nav) {
                const rect = nav.getBoundingClientRect();
                if (rect.width > 0) {
                  spots.push({
                    x: (rect.left + rect.width / 2) * dpr,
                    y: warmth.height - (rect.top + rect.height / 2) * dpr,
                    r: Math.max(rect.width * 0.62, 140) * dpr,
                  });
                }
              }
              const heads = Array.from(document.querySelectorAll('h1, h2'))
                .map((el) => el.getBoundingClientRect())
                .filter((rect) => rect.width > 8 && rect.bottom > 0 && rect.top < window.innerHeight)
                .sort(
                  (a, b) =>
                    Math.abs(a.top + a.height / 2 - window.innerHeight * 0.4) -
                    Math.abs(b.top + b.height / 2 - window.innerHeight * 0.4),
                )
                .slice(0, 7);
              for (const rect of heads) {
                spots.push({
                  x: (rect.left + rect.width / 2) * dpr,
                  y: warmth.height - (rect.top + rect.height / 2) * dpr,
                  r: Math.max(rect.width, rect.height * 2.4, 150) * 0.62 * dpr,
                });
              }
              spots.slice(0, 8).forEach((spot, i) => {
                lights[i * 3] = spot.x;
                lights[i * 3 + 1] = spot.y;
                lights[i * 3 + 2] = spot.r;
              });
            };
            window.addEventListener('resize', () => {
              resizeWarmth();
              measureWarmth();
            }, { passive: true });
            resizeWarmth();
            measureWarmth();
            let frame = 0;
            const drawWarmth = (time: number) => {
              frame += 1;
              if (frame % 4 === 0) measureWarmth();
              gl.uniform2f(uRes, warmth.width, warmth.height);
              gl.uniform1f(uTime, time * 0.001);
              gl.uniform3fv(uL, lights);
              gl.drawArrays(gl.TRIANGLES, 0, 3);
            };
            const reducedWarmth = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reducedWarmth) drawWarmth(4200);
            else {
              const tick = (time: number) => {
                warmthRaf = requestAnimationFrame(tick);
                if (document.hidden) return;
                drawWarmth(time);
              };
              warmthRaf = requestAnimationFrame(tick);
            }
          }
        }
      }

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const playedLogos = new WeakSet<Element>();
      const bindLogos = () => {
        if (reduce) return;
        document.querySelectorAll('.aura-logo').forEach((logo) => {
          if (playedLogos.has(logo)) return;
          playedLogos.add(logo);
          const host = logo.closest('a');
          host?.addEventListener('pointerenter', () => {
            logo.classList.remove('is-play');
            void logo.getBoundingClientRect();
            logo.classList.add('is-play');
          });
        });
      };
      bindLogos();
      bindSiteCursor();
      bindAmbient();
      bindFields();
      bindRidgeLoad();
      const grain = document.querySelector('.film-grain');
      if (grain) {
        const syncGrain = () => grain.classList.toggle('is-paused', document.hidden);
        document.addEventListener('visibilitychange', syncGrain);
        syncGrain();
      }
      document.addEventListener('astro:page-load', () => {
        bindLogos();
        bindAmbient();
        bindFields();
        bindRidgeLoad();
        window.__lenis?.resize();
      });

      const menuBtn = document.querySelector('.nav-menu') as HTMLButtonElement | null;
      const panel = document.getElementById('story-menu');
      const pageMain = document.querySelector('.page-main') as HTMLElement | null;
      const foot = document.querySelector('.site-foot') as HTMLElement | null;
      const navLock = Array.from(document.querySelectorAll('.nav-brand, .nav-words, .nav-cta, .nav-quote, .ambient')) as HTMLElement[];
      const line = panel?.querySelector('.menu-horizon') as HTMLElement | null;
      const clip = panel?.querySelector('.menu-ridge-clip') as HTMLElement | null;
      const shift = panel?.querySelector('.menu-ridge-shift') as HTMLElement | null;
      const ridge = panel?.querySelector('.menu-ridge') as HTMLElement | null;
      const ring = panel?.querySelector('.menu-ring') as HTMLElement | null;
      const menuBits = () => panel?.querySelectorAll('.nav-thesis, .nav-groups a, .nav-groups p') ?? [];
      const motionOff = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const menuPaint = [panel, line, clip, shift, ridge, ring].filter(Boolean);
      let menuTl: gsap.core.Timeline | null = null;
      let menuGeneration = 0;
      let menuOpen = false;
      const wipe = { p: 1 };
      const applyWipe = () => {
        if (!clip || !shift) return;
        const p = Math.max(wipe.p, 0.04);
        gsap.set(clip, { scaleX: p, transformOrigin: '0% 50%' });
        gsap.set(shift, { scaleX: 1 / p, transformOrigin: '0% 50%' });
      };
      const paintMenuWord = (open: boolean) => {
        if (!menuBtn) return;
        const word = menuBtn.querySelector('.menu-word');
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        menuBtn.setAttribute('aria-label', open ? (word ? 'Close' : 'Close menu') : 'Menu');
        if (word) word.textContent = open ? 'Close' : 'Menu';
      };
      const setLocked = (on: boolean) => {
        [pageMain, foot, ...navLock].forEach((el) => {
          if (!el) return;
          if (on) el.setAttribute('inert', '');
          else el.removeAttribute('inert');
        });
        if (on) window.__lenis?.stop();
        else window.__lenis?.start();
      };
      const hardClose = (restoreFocus: boolean) => {
        menuGeneration += 1;
        menuTl?.kill();
        menuTl = null;
        menuOpen = false;
        panel?.setAttribute('hidden', '');
        panel?.classList.remove('is-open', 'is-gsap');
        document.body.classList.remove('menu-open');
        paintMenuWord(false);
        setLocked(false);
        gsap.set(menuPaint, { clearProps: 'all' });
        gsap.set(menuBits(), { clearProps: 'all' });
        if (restoreFocus) menuBtn?.focus({ preventScroll: true });
      };
      const closeMenu = (restoreFocus: boolean) => {
        if (!menuBtn || !panel || !menuOpen) return;
        if (menuBtn.getAttribute('aria-expanded') !== 'true') return;
        const gen = (menuGeneration += 1);
        paintMenuWord(false);
        if (motionOff()) {
          hardClose(restoreFocus);
          return;
        }
        menuTl?.kill();
        menuTl = gsap.timeline({
          onComplete: () => {
            if (gen !== menuGeneration) return;
            menuTl = null;
            menuOpen = false;
            panel.setAttribute('hidden', '');
            panel.classList.remove('is-open', 'is-gsap');
            document.body.classList.remove('menu-open');
            setLocked(false);
            gsap.set(menuPaint, { clearProps: 'all' });
            gsap.set(menuBits(), { clearProps: 'all' });
            if (restoreFocus) menuBtn.focus({ preventScroll: true });
          },
        });
        menuTl.to(menuBits(), { opacity: 0, duration: 0.4, ease: 'power2.inOut' }, 0);
        menuTl.to([ring, ridge].filter(Boolean), { opacity: 0, duration: 0.5, ease: 'power2.inOut' }, 0);
        if (line) menuTl.to(line, { scaleX: 0.08, duration: 0.6, ease: 'power3.inOut', transformOrigin: '100% 50%' }, 0);
        menuTl.to(panel, { opacity: 0, duration: 0.6, ease: 'power2.inOut' }, 0.05);
      };
      const openMenu = () => {
        if (!menuBtn || !panel || menuOpen) return;
        menuGeneration += 1;
        menuTl?.kill();
        menuOpen = true;
        const calm = motionOff();
        paintMenuWord(true);
        document.body.classList.add('menu-open');
        document.querySelector('.topbar')?.classList.remove('is-away');
        setLocked(true);
        if (!calm) {
          panel.classList.add('is-gsap');
          wipe.p = 0.06;
          applyWipe();
          gsap.set(ridge, { opacity: 1 });
          gsap.set(panel, { opacity: 0 });
          gsap.set(line, { scaleX: 0.08, transformOrigin: '100% 50%' });
          gsap.set(ring, { opacity: 0 });
          gsap.set(menuBits(), { opacity: 0, y: 14 });
        }
        panel.removeAttribute('hidden');
        panel.classList.add('is-open');
        const first = panel.querySelector('.nav-groups a') as HTMLElement | null;
        window.setTimeout(() => first?.focus({ preventScroll: true }), calm ? 0 : 30);
        if (calm || !clip || !shift) return;
        const gen = menuGeneration;
        menuTl = gsap.timeline({
          onComplete: () => {
            if (gen !== menuGeneration) return;
            gsap.set(menuBits(), { clearProps: 'transform,opacity' });
          },
        });
        const horizon = panel.classList.contains('is-horizon');
        menuTl.to(panel, { opacity: 1, duration: 1.05, ease: 'power2.inOut' }, 0);
        if (line) menuTl.to(line, { scaleX: 1, duration: horizon ? 1.2 : 1.7, ease: 'power3.inOut', transformOrigin: '100% 50%' }, 0);
        menuTl.to(wipe, { p: 1, duration: horizon ? 1.2 : 1.9, ease: 'power3.inOut', onUpdate: applyWipe }, horizon ? 0.05 : 0.12);
        if (ring) menuTl.to(ring, { opacity: 1, duration: horizon ? 0.8 : 1.1, ease: 'power2.inOut' }, horizon ? 1.15 : 1);
        menuTl.to(menuBits(), { y: 0, opacity: 1, duration: 0.95, stagger: 0.04, ease: 'power3.out' }, 0.32);
      };
      menuBtn?.addEventListener('click', () => {
        if (menuBtn.getAttribute('aria-expanded') === 'true') closeMenu(false);
        else if (!menuOpen) openMenu();
      });
      panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => hardClose(false)));
      window.addEventListener('keydown', (e) => {
        if (!menuOpen || !menuBtn || !panel) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          closeMenu(true);
          return;
        }
        if (e.key !== 'Tab') return;
        const links = Array.from(panel.querySelectorAll('.nav-groups a')) as HTMLElement[];
        const items = [menuBtn, ...links];
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement as HTMLElement | null;
        const inside = active ? items.includes(active) : false;
        if (e.shiftKey && (active === first || !inside)) {
          e.preventDefault();
          last.focus({ preventScroll: true });
        } else if (!e.shiftKey && (active === last || !inside)) {
          e.preventDefault();
          first.focus({ preventScroll: true });
        }
      });

      const thumb = document.querySelector('.scroll-rail-thumb') as HTMLElement | null;
      const moveThumb = (scroll?: number) => {
        if (!thumb) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const y = typeof scroll === 'number' ? scroll : (window.__lenis?.scroll ?? window.scrollY);
        const p = max > 0 ? y / max : 0;
        thumb.style.transform = `translate3d(0, ${p * 81}px, 0)`;
      };
      const bindRail = () => {
        window.__lenis?.on('scroll', (event: { scroll: number }) => moveThumb(event.scroll));
      };
      if (window.__lenis) bindRail();
      else window.addEventListener('scroll', () => moveThumb(), { passive: true });
      moveThumb();

      let topbarLast = 0;
      const applyTopbar = (y: number) => {
        const bar = document.querySelector<HTMLElement>('.topbar');
        if (!bar) return;
        const delta = y - topbarLast;
        bar.classList.toggle('is-frost', y > 80);
        const open = document.body.classList.contains('menu-open');
        if (!open && y > 80 && delta > 2) bar.classList.add('is-away');
        else if (delta < -4 || y <= 8) bar.classList.remove('is-away');
        topbarLast = y;
      };
      const bindTopbarScroll = () => {
        const y = window.__lenis?.scroll ?? window.scrollY;
        topbarLast = y;
        applyTopbar(y);
        window.__lenis?.on('scroll', (event: { scroll: number }) => applyTopbar(event.scroll));
      };
      document.querySelector('.topbar')?.addEventListener('focusin', () => {
        document.querySelector('.topbar')?.classList.remove('is-away');
      });
      bindTopbarScroll();

      document.addEventListener('astro:page-load', () => {
        initSmoothScroll();
        bindRail();
        bindTopbarScroll();
        bindDaylight();
        requestAnimationFrame(() => {
          ScrollTrigger.refresh();
          window.__lenis?.resize();
          moveThumb();
        });
      });

      if (import.meta.hot) {
        import.meta.hot.dispose(() => {
          cancelAnimationFrame(tracerRaf);
          cancelAnimationFrame(warmthRaf);
          menuTl?.kill();
        });
      }
    </script>
  </body>
</html>
