---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Ambient from '../components/Ambient.astro';
import RidgeLoad from '../components/RidgeLoad.astro';
import AuraMark from '../components/AuraMark.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { contactEmail, contactPhone, phoneTel } from '../data/site';
import { organizationJson } from '../lib/organization';

interface Props {
  title: string;
  description?: string;
  descriptor?: string;
  noindex?: boolean;
}

const tagline = 'Return to Aura.';
const taglineMore = 'One beautiful room at a time.';
const about = 'Return to Aura. One beautiful room at a time.';
const { title: rawTitle, description = about, noindex = false } = Astro.props;
const brandTitle = (raw: string) => {
  if (raw === 'Aura Homes' || raw.endsWith('| Aura Homes')) return raw;
  if (raw.startsWith('Aura Homes | ')) return `${raw.slice('Aura Homes | '.length)} | Aura Homes`;
  if (raw.startsWith('Aura Farms | ')) return `${raw.slice('Aura Farms | '.length)} | Aura Homes`;
  return `${raw} | Aura Homes`;
};
const title = brandTitle(rawTitle);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const origin = Astro.site ?? Astro.url.origin;
const pageUrl = new URL(path, origin).href;
const canonical = pageUrl;
// Versioned 1200x630 PNG in /public (source: design/social-card). Bump the filename when the art changes so scrapers refetch.
const ogImage = new URL('/og-aura-2026-10.png', origin).href;
const organization = organizationJson(origin);
const ogAlt = 'Aura Homes: a dark glass room with a warm oak interior in a dusk meadow, with the line Return to Aura. One beautiful room at a time.';
const isHome = path === '/';
const isBuilder = path.startsWith('/builder') || path.startsWith('/build-your-own');
const filmBar = isHome || path.startsWith('/back-to-nature');
const showFoot = !isHome;
const reachEmail = contactEmail.trim();
const reachPhone = contactPhone.trim();
const reachTel = phoneTel(reachPhone);
const here = (href: string) => (href === '/journal' ? path.startsWith('/journal') : path === href);
const menu = [
  {
    label: 'The room',
    links: [
      { href: '/story', label: 'Story' },
      { href: '/rooms', label: 'Rooms' },
      { href: '/customs', label: 'Customs' },
      { href: '/build-your-own', label: 'Build Your Own' },
    ],
  },
  {
    label: 'The land',
    links: [
      { href: '/master-plan', label: 'Master plan' },
      { href: '/back-to-nature', label: 'Back to nature' },
      { href: '/journal', label: 'Journal' },
    ],
  },
  {
    label: 'A note',
    links: [
      { href: '/pre-order', label: 'Pre-order' },
      { href: '/faq', label: 'FAQ' },
      { href: '/contact', label: 'Contact' },
    ],
  },
];
const innerMenu = [
  menu[0],
  {
    label: 'The land',
    links: [
      { href: '/master-plan', label: 'Master Plan' },
      { href: '/farms', label: 'Aura Farms' },
      { href: '/h2o', label: 'Aura H2O' },
      { href: '/back-to-nature', label: 'Back to nature' },
      { href: '/journal', label: 'Journal' },
    ],
  },
  menu[2],
];
const topLinks = [
  { href: '/rooms', label: 'Rooms' },
  { href: '/customs', label: 'Customs' },
  { href: '/master-plan', label: 'Master Plan' },
  { href: '/farms', label: 'Aura Farms' },
  { href: '/h2o', label: 'Aura H2O' },
  { href: '/story', label: 'Story' },
];
const foot = innerMenu.flatMap((group) => group.links);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    {!isHome && <ClientRouter />}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <Font cssVariable="--font-cinzel" preload />
    <Font cssVariable="--font-inter" preload />
    {!isHome && (
      <script is:inline>
        try {
          if (localStorage.getItem('aura-ridge') === '1') document.documentElement.classList.add('ridge-seen');
        } catch (error) {
          /* a private window can still play the ridge once */
        }
      </script>
    )}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    <meta property="og:site_name" content="Aura Homes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
  </head>
  <body class:list={['bg-alabaster text-obsidian font-inter antialiased', { 'is-builder': isBuilder, 'film-bar': filmBar }]}>
    {isHome ? (
      <>
        <canvas id="tracers-canvas" class="tracers-canvas" aria-hidden="true"></canvas>
        <canvas id="warmth-canvas" class="warmth-canvas" aria-hidden="true"></canvas>
        <div class="page-grain" aria-hidden="true"></div>
        <div class="scroll-rail" aria-hidden="true"><div class="scroll-rail-thumb"></div></div>
        <div class="site-cursor" aria-hidden="true"><span class="site-cursor-word"></span></div>
      </>
    ) : (
      <>
        <canvas id="tracers-canvas" class="tracers-canvas" aria-hidden="true" transition:name="tracers" transition:persist="tracers" transition:animate="none"></canvas>
        <canvas id="warmth-canvas" class="warmth-canvas" aria-hidden="true" transition:name="warmth" transition:persist="warmth" transition:animate="none"></canvas>
        <div class="page-grain film-grain" aria-hidden="true" transition:name="grain" transition:persist="grain" transition:animate="none">
          <div class="film-grain-pane"></div>
          <div class="film-grain-pane is-b"></div>
        </div>
        <div class="daylight" id="daylight" aria-hidden="true" transition:name="daylight" transition:persist="daylight" transition:animate="none">
          <div class="daylight-sun daylight-dawn"></div>
          <div class="daylight-sun daylight-gold"></div>
          <div class="daylight-sun daylight-dusk"></div>
        </div>
        <div class="scroll-rail" aria-hidden="true" transition:name="rail" transition:persist="rail" transition:animate="none"><div class="scroll-rail-thumb"></div></div>
        <div class="site-cursor" aria-hidden="true" transition:name="cursor-ring" transition:persist="cursor-ring" transition:animate="none"><span class="site-cursor-word"></span></div>
        <div class="horizon-wipe" transition:name="horizon" transition:animate="none" aria-hidden="true"></div>
      </>
    )}

    <SiteHeader path={path} filmBar={filmBar} topLinks={topLinks} groups={innerMenu} tagline={tagline} taglineMore={taglineMore} />

    <Ambient persist={!isHome} />
    {!isHome && <RidgeLoad />}

    <div class="page-main relative z-10">
      <slot />
    </div>
    {showFoot && (
      <footer class="site-foot">
        <a href="/" class="foot-brand">
          <AuraMark play />
          <span class="foot-name">AURA</span>
        </a>
        <p class="foot-line">{tagline}</p>
        <p class="foot-quiet">{taglineMore}</p>
        <p class="foot-place">Edmonton, Alberta. Shipping across Canada.</p>
        <nav class="foot-nav" aria-label="Footer">
          {foot.map((item) => (
            <a href={item.href} aria-current={here(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        {reachEmail && <p class="foot-reach"><a href={`mailto:${reachEmail}`}>Email: {reachEmail}</a></p>}
        {reachPhone && reachTel && <p class="foot-reach"><a href={reachTel}>Phone: {reachPhone}</a></p>}
        {reachPhone && !reachTel && <p class="foot-reach">Phone: {reachPhone}</p>}
        {!reachEmail && !reachPhone && <p class="foot-reach"><a href="/contact">Write to us</a></p>}
        <a class="foot-credit" href="/credits" aria-current={path === '/credits' ? 'page' : undefined}>Credits</a>
      </footer>
    )}

    <script>
      import { gsap } from 'gsap';
      import { initSmoothScroll, resetPageMotion, stopSmoothScroll, ScrollTrigger } from '../scripts/motion';
      import { bindDaylight } from '../scripts/daylight';
      import { bindSiteCursor } from '../scripts/cursor';
      import { bindAmbient } from '../scripts/ambient';
      import { bindFields } from '../scripts/forms';
      import { bindRidgeLoad } from '../scripts/ridge-load';
      import { bindHeadingGlow, disposeHeadingGlow } from '../scripts/heading-glow';
      import { bindTracers, disposeTracers } from '../scripts/tracers';

      initSmoothScroll();
      bindDaylight();

      const copyCurrent = (live: ParentNode | null, incoming: ParentNode | null) => {
        if (!live || !incoming) return;
        const nextLinks = incoming.querySelectorAll<HTMLAnchorElement>('a[href]');
        live.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link, index) => {
          const source = nextLinks[index];
          if (!source || link.getAttribute('href') !== source.getAttribute('href')) return;
          const current = source.getAttribute('aria-current');
          if (current) link.setAttribute('aria-current', current);
          else link.removeAttribute('aria-current');
        });
      };

      document.addEventListener('astro:before-swap', ((event: Event) => {
        disposeTracers();
        resetPageMotion();
        stopSmoothScroll();
        document.querySelectorAll('.site-nav .aura-logo').forEach((logo) => {
          logo.classList.remove('is-play');
        });
        const incoming = (event as Event & { newDocument?: Document }).newDocument;
        if (!incoming) return;
        copyCurrent(document.querySelector('.site-nav'), incoming.querySelector('.site-nav'));
        copyCurrent(document.getElementById('story-menu'), incoming.getElementById('story-menu'));
        const liveQuote = document.querySelector<HTMLAnchorElement>('.site-nav .nav-quote');
        const nextQuote = incoming.querySelector<HTMLAnchorElement>('.site-nav .nav-quote');
        if (liveQuote && nextQuote) {
          const current = nextQuote.getAttribute('aria-current');
          if (current) liveQuote.setAttribute('aria-current', current);
          else liveQuote.removeAttribute('aria-current');
        }
        const nextBar = incoming.querySelector('.topbar');
        const liveBar = document.querySelector('.topbar');
        if (liveBar && nextBar) liveBar.classList.toggle('is-clear', nextBar.classList.contains('is-clear'));
      }) as EventListener);

      document.addEventListener('astro:after-swap', () => {
        window.scrollTo(0, 0);
        window.__lenis?.scrollTo(0, { immediate: true, force: true });
        window.__lenis?.resize();
      });

      bindTracers();

      bindHeadingGlow();

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const playedLogos = new WeakSet<Element>();
      const bindLogos = () => {
        if (reduce) return;
        document.querySelectorAll('.aura-logo').forEach((logo) => {
          if (playedLogos.has(logo)) return;
          playedLogos.add(logo);
          const host = logo.closest('a');
          host?.addEventListener('pointerenter', () => {
            logo.classList.remove('is-play');
            void logo.getBoundingClientRect();
            logo.classList.add('is-play');
          });
        });
      };
      bindLogos();
      bindSiteCursor();
      bindAmbient();
      bindFields();
      bindRidgeLoad();
      const grain = document.querySelector('.film-grain');
      if (grain) {
        const syncGrain = () => grain.classList.toggle('is-paused', document.hidden);
        document.addEventListener('visibilitychange', syncGrain);
        syncGrain();
      }
      document.addEventListener('astro:page-load', () => {
        bindLogos();
        bindAmbient();
        bindFields();
        bindRidgeLoad();
        window.__lenis?.resize();
      });

      const menuBtn = document.querySelector('.nav-menu') as HTMLButtonElement | null;
      const panel = document.getElementById('story-menu');
      const pageMain = document.querySelector('.page-main') as HTMLElement | null;
      const foot = document.querySelector('.site-foot') as HTMLElement | null;
      const navLock = Array.from(document.querySelectorAll('.nav-brand, .nav-words, .nav-quote, .ambient')) as HTMLElement[];
      const line = panel?.querySelector('.menu-horizon') as HTMLElement | null;
      const clip = panel?.querySelector('.menu-ridge-clip') as HTMLElement | null;
      const shift = panel?.querySelector('.menu-ridge-shift') as HTMLElement | null;
      const ridge = panel?.querySelector('.menu-ridge') as HTMLElement | null;
      const ring = panel?.querySelector('.menu-ring') as HTMLElement | null;
      const menuBits = () => panel?.querySelectorAll('.nav-thesis, .nav-groups a, .nav-groups p') ?? [];
      const motionOff = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const menuPaint = [panel, line, clip, shift, ridge, ring].filter(Boolean);
      let menuTl: gsap.core.Timeline | null = null;
      let menuGeneration = 0;
      let menuOpen = false;
      const wipe = { p: 1 };
      const applyWipe = () => {
        if (!clip || !shift) return;
        const p = Math.max(wipe.p, 0.04);
        gsap.set(clip, { scaleX: p, transformOrigin: '0% 50%' });
        gsap.set(shift, { scaleX: 1 / p, transformOrigin: '0% 50%' });
      };
      const paintMenuWord = (open: boolean) => {
        if (!menuBtn) return;
        const word = menuBtn.querySelector('.menu-word');
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        menuBtn.setAttribute('aria-label', open ? (word ? 'Close' : 'Close menu') : 'Menu');
        if (word) word.textContent = open ? 'Close' : 'Menu';
      };
      const setLocked = (on: boolean) => {
        [pageMain, foot, ...navLock].forEach((el) => {
          if (!el) return;
          if (on) el.setAttribute('inert', '');
          else el.removeAttribute('inert');
        });
        if (on) window.__lenis?.stop();
        else window.__lenis?.start();
      };
      const hardClose = (restoreFocus: boolean) => {
        menuGeneration += 1;
        menuTl?.kill();
        menuTl = null;
        menuOpen = false;
        panel?.setAttribute('hidden', '');
        panel?.classList.remove('is-open', 'is-gsap');
        document.body.classList.remove('menu-open');
        paintMenuWord(false);
        setLocked(false);
        gsap.set(menuPaint, { clearProps: 'all' });
        gsap.set(menuBits(), { clearProps: 'all' });
        if (restoreFocus) menuBtn?.focus({ preventScroll: true });
      };
      const closeMenu = (restoreFocus: boolean) => {
        if (!menuBtn || !panel || !menuOpen) return;
        if (menuBtn.getAttribute('aria-expanded') !== 'true') return;
        const gen = (menuGeneration += 1);
        paintMenuWord(false);
        if (motionOff()) {
          hardClose(restoreFocus);
          return;
        }
        menuTl?.kill();
        menuTl = gsap.timeline({
          onComplete: () => {
            if (gen !== menuGeneration) return;
            menuTl = null;
            menuOpen = false;
            panel.setAttribute('hidden', '');
            panel.classList.remove('is-open', 'is-gsap');
            document.body.classList.remove('menu-open');
            setLocked(false);
            gsap.set(menuPaint, { clearProps: 'all' });
            gsap.set(menuBits(), { clearProps: 'all' });
            if (restoreFocus) menuBtn.focus({ preventScroll: true });
          },
        });
        menuTl.to(menuBits(), { opacity: 0, duration: 0.4, ease: 'power2.inOut' }, 0);
        menuTl.to([ring, ridge].filter(Boolean), { opacity: 0, duration: 0.5, ease: 'power2.inOut' }, 0);
        if (line) menuTl.to(line, { scaleX: 0.08, duration: 0.6, ease: 'power3.inOut', transformOrigin: '100% 50%' }, 0);
        menuTl.to(panel, { opacity: 0, duration: 0.6, ease: 'power2.inOut' }, 0.05);
      };
      const openMenu = () => {
        if (!menuBtn || !panel || menuOpen) return;
        menuGeneration += 1;
        menuTl?.kill();
        menuOpen = true;
        const calm = motionOff();
        paintMenuWord(true);
        document.body.classList.add('menu-open');
        document.querySelector('.topbar')?.classList.remove('is-away');
        setLocked(true);
        if (!calm) {
          panel.classList.add('is-gsap');
          wipe.p = 0.06;
          applyWipe();
          gsap.set(ridge, { opacity: 1 });
          gsap.set(panel, { opacity: 0 });
          gsap.set(line, { scaleX: 0.08, transformOrigin: '100% 50%' });
          gsap.set(ring, { opacity: 0 });
          gsap.set(menuBits(), { opacity: 0, y: 14 });
        }
        panel.removeAttribute('hidden');
        panel.classList.add('is-open');
        const first = panel.querySelector('.nav-groups a') as HTMLElement | null;
        window.setTimeout(() => first?.focus({ preventScroll: true }), calm ? 0 : 30);
        if (calm || !clip || !shift) return;
        const gen = menuGeneration;
        menuTl = gsap.timeline({
          onComplete: () => {
            if (gen !== menuGeneration) return;
            gsap.set(menuBits(), { clearProps: 'transform,opacity' });
          },
        });
        const horizon = panel.classList.contains('is-horizon');
        menuTl.to(panel, { opacity: 1, duration: 1.05, ease: 'power2.inOut' }, 0);
        if (line) menuTl.to(line, { scaleX: 1, duration: horizon ? 1.2 : 1.7, ease: 'power3.inOut', transformOrigin: '100% 50%' }, 0);
        menuTl.to(wipe, { p: 1, duration: horizon ? 1.2 : 1.9, ease: 'power3.inOut', onUpdate: applyWipe }, horizon ? 0.05 : 0.12);
        if (ring) menuTl.to(ring, { opacity: 1, duration: horizon ? 0.8 : 1.1, ease: 'power2.inOut' }, horizon ? 1.15 : 1);
        menuTl.to(menuBits(), { y: 0, opacity: 1, duration: 0.95, stagger: 0.04, ease: 'power3.out' }, 0.32);
      };
      menuBtn?.addEventListener('click', () => {
        if (menuBtn.getAttribute('aria-expanded') === 'true') closeMenu(false);
        else if (!menuOpen) openMenu();
      });
      panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => hardClose(false)));
      window.addEventListener('keydown', (e) => {
        if (!menuOpen || !menuBtn || !panel) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          closeMenu(true);
          return;
        }
        if (e.key !== 'Tab') return;
        const links = Array.from(panel.querySelectorAll('.nav-groups a')) as HTMLElement[];
        const items = [menuBtn, ...links];
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement as HTMLElement | null;
        const inside = active ? items.includes(active) : false;
        if (e.shiftKey && (active === first || !inside)) {
          e.preventDefault();
          last.focus({ preventScroll: true });
        } else if (!e.shiftKey && (active === last || !inside)) {
          e.preventDefault();
          first.focus({ preventScroll: true });
        }
      });

      const thumb = document.querySelector('.scroll-rail-thumb') as HTMLElement | null;
      const moveThumb = (scroll?: number) => {
        if (!thumb) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const y = typeof scroll === 'number' ? scroll : (window.__lenis?.scroll ?? window.scrollY);
        const p = max > 0 ? y / max : 0;
        thumb.style.transform = `translate3d(0, ${p * 81}px, 0)`;
      };
      const bindRail = () => {
        window.__lenis?.on('scroll', (event: { scroll: number }) => moveThumb(event.scroll));
      };
      if (window.__lenis) bindRail();
      else window.addEventListener('scroll', () => moveThumb(), { passive: true });
      moveThumb();

      let topbarLast = 0;
      let filmWatch: IntersectionObserver | null = null;
      const syncFilmBar = () => {
        const bar = document.querySelector<HTMLElement>('.topbar');
        if (!bar) return;
        if (!document.body.classList.contains('film-bar')) {
          bar.classList.remove('is-clear');
          return;
        }
        const hero = document.querySelector<HTMLElement>('.splash') ?? document.querySelector<HTMLElement>('[data-living-hero]');
        if (!hero) {
          bar.classList.remove('is-clear');
          return;
        }
        const box = hero.getBoundingClientRect();
        const over = box.bottom > 64 && box.top < window.innerHeight * 0.72;
        bar.classList.toggle('is-clear', over);
      };
      const bindFilmBar = () => {
        filmWatch?.disconnect();
        filmWatch = null;
        syncFilmBar();
        if (!document.body.classList.contains('film-bar')) return;
        const hero = document.querySelector<HTMLElement>('.splash') ?? document.querySelector<HTMLElement>('[data-living-hero]');
        if (!hero) return;
        filmWatch = new IntersectionObserver(() => syncFilmBar(), { threshold: [0, 0.02, 0.2, 0.5, 1] });
        filmWatch.observe(hero);
      };
      const applyTopbar = (y: number) => {
        const bar = document.querySelector<HTMLElement>('.topbar');
        if (!bar) return;
        const delta = y - topbarLast;
        bar.classList.toggle('is-frost', y > 80);
        syncFilmBar();
        const open = document.body.classList.contains('menu-open');
        if (!open && y > 80 && delta > 2) bar.classList.add('is-away');
        else if (delta < -4 || y <= 8) bar.classList.remove('is-away');
        topbarLast = y;
      };
      const bindTopbarScroll = () => {
        const y = window.__lenis?.scroll ?? window.scrollY;
        topbarLast = y;
        bindFilmBar();
        applyTopbar(y);
        window.__lenis?.on('scroll', (event: { scroll: number }) => applyTopbar(event.scroll));
      };
      document.querySelector('.topbar')?.addEventListener('focusin', () => {
        document.querySelector('.topbar')?.classList.remove('is-away');
      });
      bindTopbarScroll();

      document.addEventListener('astro:page-load', () => {
        initSmoothScroll();
        bindTracers();
        bindRail();
        bindTopbarScroll();
        bindDaylight();
        requestAnimationFrame(() => {
          ScrollTrigger.refresh();
          window.__lenis?.resize();
          moveThumb();
        });
      });

      if (import.meta.hot) {
        import.meta.hot.dispose(() => {
          disposeTracers();
          disposeHeadingGlow();
          menuTl?.kill();
        });
      }
    </script>
  </body>
</html>
