---
import Join from '../components/Join.astro';
import RevealHeading from '../components/RevealHeading.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  kicker: string;
  date: string;
}

const { title, description, kicker, date } = Astro.props;
const json = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  datePublished: date,
  dateModified: date,
  description,
  author: { '@type': 'Organization', name: 'Aura Homes' },
  publisher: { '@type': 'Organization', name: 'Aura Homes' },
};
---

<BaseLayout title={`${title} | Aura Homes`} description={description} descriptor="Journal">
  <main class="article" id="top">
    <script type="application/ld+json" set:html={JSON.stringify(json)} />
    <p class="story-kicker">{kicker}</p>
    <RevealHeading as="h1">{title}</RevealHeading>
    <p class="article-date"><time datetime={date}>{date}</time></p>
    <slot />
    <p class="article-next"><a href="/journal">All notes</a> · <a href="/#enquire">Enquire</a></p>
  </main>
  <section id="enquire" class="enquire">
    <p class="story-kicker">Enquire</p>
    <RevealHeading as="h2">Got a spot in mind?</RevealHeading>
    <p class="story-lede enquire-note">Tell us which room you are dreaming about and a little about your land. You go on the waitlist.</p>
    <Join shell="unsure" />
  </section>
</BaseLayout>
