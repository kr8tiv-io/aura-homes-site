---
import Join from '../components/Join.astro';
import RevealHeading from '../components/RevealHeading.astro';
import Still from '../components/Still.astro';
import YouTube from '../components/YouTube.astro';
import { formatJournalDate } from '../lib/journal';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  cover: string;
  coverAlt: string;
  tags: string[];
  youtube?: string;
}

const { title, description, date, cover, coverAlt, tags, youtube } = Astro.props;
const published = formatJournalDate(date);
const iso = date.toISOString().slice(0, 10);
const json = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  datePublished: iso,
  dateModified: iso,
  description,
  image: new URL(cover, Astro.url).href,
  author: { '@type': 'Organization', name: 'Aura Homes' },
  publisher: { '@type': 'Organization', name: 'Aura Homes' },
};
---

<BaseLayout title={`${title} | Aura Homes`} description={description} descriptor="Journal">
  <main class="journal-post" id="top">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(json)} />
    <header class="journal-head">
      <p class="story-kicker">Journal</p>
      <RevealHeading as="h1">{title}</RevealHeading>
      <p class="journal-meta">
        <time datetime={iso}>{published}</time>
        {tags.length > 0 && <span>{tags.join(' · ')}</span>}
      </p>
      <p class="story-lede">{description}</p>
    </header>
    <figure class="journal-cover">
      <Still
        src={cover}
        alt={coverAlt}
        loading="eager"
        fetchpriority="high"
        sizes="(max-width: 800px) 100vw, 72rem"
      />
    </figure>
    <div class="journal-prose">
      <slot />
      {youtube !== undefined && <YouTube id={youtube} title={`${title}, build film`} />}
      <p class="article-next"><a href="/journal">All notes</a> · <a href="/story">Story</a></p>
    </div>
  </main>
  <section id="enquire" class="enquire">
    <p class="story-kicker">Enquire</p>
    <RevealHeading as="h2">Ask about the room.</RevealHeading>
    <p class="story-lede enquire-note">A room, a farm wall, or water from the air. The first reply starts with the site.</p>
    <Join shell="unsure" />
  </section>
</BaseLayout>

<style>
  .journal-post {
    position: relative;
    z-index: 1;
    color: #14120e;
  }
  .journal-head,
  .journal-prose {
    width: min(40rem, calc(100% - 16vw));
    margin-left: 8vw;
    margin-right: 8vw;
  }
  .journal-head {
    padding-top: 22vh;
    padding-bottom: 4vh;
  }
  :global(.journal-head h1) {
    margin: 0;
    max-width: 16em;
    font-family: var(--font-cinzel);
    font-weight: 300;
    font-size: clamp(2.5rem, 5vw, 4.4rem);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .journal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.1rem;
    margin: 1.5rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #866243;
  }
  .journal-head .story-lede {
    margin-top: 1.6rem;
  }
  .journal-cover {
    margin: 2vh 8vw 0;
    max-width: 72rem;
    overflow: hidden;
    background: #0c0d0e;
    aspect-ratio: 3 / 2;
  }
  .journal-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .journal-prose {
    padding-top: 6vh;
    padding-bottom: 10vh;
  }
  .journal-prose :global(p),
  .journal-prose :global(li) {
    font-weight: 300;
    font-size: 1.125rem;
    line-height: 1.75;
    color: rgba(20, 18, 14, 0.84);
  }
  .journal-prose :global(p) {
    margin: 1.35rem 0 0;
  }
  .journal-prose :global(p:first-child) {
    margin-top: 0;
  }
  .journal-prose :global(h2) {
    margin: 2.8rem 0 0;
    font-family: var(--font-cinzel);
    font-weight: 400;
    font-size: 1.65rem;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .journal-prose :global(h2 + p) {
    margin-top: 0.85rem;
  }
  .journal-prose :global(a) {
    color: #866243;
    text-decoration: none;
    border-bottom: 1px solid rgba(156, 122, 85, 0.55);
    padding-bottom: 0.08rem;
    transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .journal-prose :global(a:hover) {
    opacity: 0.55;
  }
  .journal-prose :global(.article-next) {
    margin-top: 3rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.6;
  }
  .journal-prose :global(.article-next a) {
    color: inherit;
    border-bottom: 0;
  }
  @media (max-width: 800px) {
    .journal-head,
    .journal-prose {
      width: auto;
      margin-left: 1.5rem;
      margin-right: 1.5rem;
    }
    .journal-head {
      padding-top: 18vh;
    }
    .journal-cover {
      margin-left: 1.5rem;
      margin-right: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .journal-prose :global(a) {
      transition: none;
    }
  }
</style>
